index 56c0680..7f6b683 100644
--- a/cef/src/osr_texture_import/vulkan.rs
+++ b/cef/src/osr_texture_import/vulkan.rs
@@ -76,8 +76,44 @@ pub fn copy_to_owned(
         external_queue_family,
         false,
     )?;
-    let submission = queue.submit([acquire, copy.finish(), release]);
+    let copy = copy.finish();
+    #[cfg(debug_assertions)]
+    enum Stage {
+        Copy,
+        Release,
+    }
+    #[cfg(debug_assertions)]
+    let completed = {
+        let (finished, completed) = std::sync::mpsc::channel();
+        let copied = finished.clone();
+        // Pinned wgpu registers command-buffer callbacks in submission order
+        // and dispatches them after the native submission completes.
+        copy.on_submitted_work_done(move || {
+            let _ = copied.send(Stage::Copy);
+        });
+        release.on_submitted_work_done(move || {
+            let _ = finished.send(Stage::Release);
+        });
+        completed
+    };
+    let submission = queue.submit([acquire, copy, release]);
     texture::wait_for_copy(device, submission)?;
+    #[cfg(debug_assertions)]
+    match (completed.try_recv(), completed.try_recv()) {
+        (Ok(Stage::Copy), Ok(Stage::Release)) => {}
+        (Ok(Stage::Release), Ok(Stage::Copy)) => {
+            return Err(TextureImportError::PlatformError {
+                message: "Vulkan ownership release was submitted before the CEF frame copy"
+                    .to_string(),
+            });
+        }
+        _ => {
+            return Err(TextureImportError::PlatformError {
+                message: "Vulkan frame copy did not complete before returning the CEF buffer"
+                    .to_string(),
+            });
+        }
+    }
     Ok(destination)
 }

