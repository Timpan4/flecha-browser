{
  "manifest_version": 3,
  "name": "Flecha OSR extension probe",
  "version": "1.0",
  "permissions": ["storage", "tabs"],
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icon.png"},
  "action": {"default_popup": "popup.html"}
}
