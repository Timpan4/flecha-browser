# Portable Linux x64 release. Use the toolchain and PGO profile pinned by the
# source revision.
is_debug = false
is_component_build = false
is_official_build = true
chrome_pgo_phase = 2
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
target_cpu = "x64"
target_os = "linux"
# Keep the public release's existing codec policy.
proprietary_codecs = false
use_remoteexec = false
treat_warnings_as_errors = false
v8_enable_builtins_gearbox = false
v8_enable_runtime_call_stats = false
