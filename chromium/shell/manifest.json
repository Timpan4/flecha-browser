{
  "manifest_version": 3,
  "name": "Flecha",
  "description": "Flecha's sidebar, Spaces and commands.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "158",
  "permissions": ["tabs", "storage", "unlimitedStorage", "sidePanel", "history", "topSites", "favicon", "clipboardWrite", "flechaPrivate", "downloads", "downloads.open", "downloads.ui", "browsingData", "contentSettings"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidebar.html" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": { "default_title": "Flecha" },
  "commands": {
    "flecha-open-location": { "description": "Open the location field (sent by the browser for Cmd+L)" }
  }
}
