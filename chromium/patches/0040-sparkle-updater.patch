+
+// Flecha: Sparkle 2 (https://sparkle-project.org) updates the app. Release
+// builds carry Sparkle.framework in Contents/Frameworks (the
+// flecha_sparkle_framework GN arg), and the feed and key in the Info.plist
+// (SUFeedURL, SUPublicEDKey). It is loaded when the app starts, so Flecha
+// doesn't link it: dev builds, which don't carry it, simply never update.
+// This is the part of SPUStandardUpdaterController's API used here.
+@protocol FlechaSparkleUpdaterController
+- (instancetype)initWithStartingUpdater:(BOOL)startUpdater
+                        updaterDelegate:(id)updaterDelegate
+                     userDriverDelegate:(id)userDriverDelegate;
+- (void)checkForUpdates:(id)sender;
+@end
 
 @implementation AppController {
+  // Flecha: Sparkle's updater controller, if the app carries Sparkle.
+  NSObject* _flechaUpdater;
+
   // Manages the state of the command menu items.
   std::unique_ptr<CommandUpdater> _menuState;
 
@@ -1233,6 +1249,54 @@
 // Placed here for 2 reasons:
 // 1) Same spot as other Pref stuff
 // 2) Try and be friendly by keeping this after app launch
+// Flecha: starts Sparkle's standard updater (it checks the feed on its own
+// schedule, SUEnableAutomaticChecks) and adds "Check for Updates…" under
+// "About Flecha" in the app menu. Without Sparkle.framework in the app, does
+// nothing.
+- (void)startFlechaUpdater {
+  if (_flechaUpdater) {
+    return;
+  }
+  NSURL* frameworkURL = [NSBundle.mainBundle.privateFrameworksURL
+      URLByAppendingPathComponent:@"Sparkle.framework"];
+  NSBundle* sparkle = [NSBundle bundleWithURL:frameworkURL];
+  if (!sparkle) {
+    return;
+  }
+  NSError* error = nil;
+  if (![sparkle loadAndReturnError:&error]) {
+    LOG(ERROR) << "Flecha: can't load Sparkle: "
+               << base::SysNSStringToUTF8(error.localizedDescription);
+    return;
+  }
+  Class controllerClass = NSClassFromString(@"SPUStandardUpdaterController");
+  if (![controllerClass instancesRespondToSelector:@selector
+                        (initWithStartingUpdater:
+                                 updaterDelegate:userDriverDelegate:)]) {
+    LOG(ERROR) << "Flecha: Sparkle has no SPUStandardUpdaterController";
+    return;
+  }
+  NSObject<FlechaSparkleUpdaterController>* updater =
+      [[controllerClass alloc] initWithStartingUpdater:YES
+                                       updaterDelegate:nil
+                                    userDriverDelegate:nil];
+  _flechaUpdater = updater;
+
+  NSMenu* appMenu = [[NSApp.mainMenu itemWithTag:IDC_CHROME_MENU] submenu];
+  const NSInteger about = [appMenu indexOfItemWithTag:IDC_ABOUT];
+  if (!appMenu || about < 0) {
+    return;
+  }
+  NSMenuItem* item =
+      [[NSMenuItem alloc] initWithTitle:@"Check for Updates…"
+                                 action:@selector(checkForUpdates:)
+                          keyEquivalent:@""];
+  // Sparkle's controller enables the item (-validateMenuItem:) while it can
+  // check.
+  item.target = updater;
+  [appMenu insertItem:item atIndex:about + 1];
+}
