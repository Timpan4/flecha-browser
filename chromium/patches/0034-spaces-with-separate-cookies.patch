+#ifndef CHROME_BROWSER_FLECHA_FLECHA_SPACES_H_
+#define CHROME_BROWSER_FLECHA_FLECHA_SPACES_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/security_principal.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+// Spaces with separate cookies and logins ("Separate Cookies and Logins" in
+// the Space menu), like the Electron spike's persist:space-<id> session
+// partitions. The tabs of such a Space live in a storage partition of their
+// own: cookies, localStorage, IndexedDB, service workers, cache and the rest,
+// on disk under <profile>/Storage/ext/flecha-space/<hash of the name>, so it
+// stays across restarts. The shell names the partition (the Space's id) and
+// opens the Space's tabs in it (chrome.flechaPrivate.createTab).
+//
+// A tab's partition is fixed for its life: its SiteInstance is made with
+// SiteInstance::CreateForFixedStoragePartition(), which Chromium keeps across
+// navigations, cross-site ones and new BrowsingInstances included (as for
+// <webview>). Tabs a page opens stay in its partition: window.open() shares
+// the opener's BrowsingInstance, and links to a new tab (noopener, the
+// context menu's "Open Link in New Tab", Peek) inherit it
+// (FlechaSiteInstanceFor()). A tab moving to another Space can't change
+// partition, so the shell closes it and opens it again in the other one.
+//
+// Header-only: every user already depends on //content/public/browser.
+
+inline constexpr char kFlechaSpacePartitionDomain[] = "flecha-space";
+
+// The storage partition of the Space named `name` (the shell's Space id). In
+// an off-the-record profile it is in memory, like the rest of that profile.
+inline content::StoragePartitionConfig FlechaSpacePartition(
+    content::BrowserContext* context,
+    const std::string& name) {
+  return content::StoragePartitionConfig::Create(
+      context, kFlechaSpacePartitionDomain, name, context->IsOffTheRecord());
+}
+
+inline bool IsFlechaSpacePartition(
+    const content::StoragePartitionConfig& config) {
+  return !config.is_default() &&
+         config.partition_domain() == kFlechaSpacePartitionDomain;
+}
+
+// The Space partition `contents` is in, or "" (the profile's own storage).
+inline std::string FlechaSpaceOf(content::WebContents* contents) {
+  if (!contents) {
+    return std::string();
+  }
+  const content::StoragePartitionConfig& config =
+      contents->GetSiteInstance()->GetSecurityPrincipal()
+          .GetStoragePartitionConfig();
+  return IsFlechaSpacePartition(config) ? config.partition_name()
+                                        : std::string();
+}
+
+// A SiteInstance in a new BrowsingInstance for `url`, in the Space partition
+// `source` is in; null when `source` is in the profile's own storage (then
+// the caller makes its SiteInstance as usual).
+inline scoped_refptr<content::SiteInstance> FlechaSiteInstanceFor(
+    content::WebContents* source,
+    const GURL& url) {
+  if (!source) {
+    return nullptr;
+  }
+  const content::StoragePartitionConfig& config =
+      source->GetSiteInstance()->GetSecurityPrincipal()
+          .GetStoragePartitionConfig();
+  if (!IsFlechaSpacePartition(config)) {
+    return nullptr;
+  }
+  return content::SiteInstance::CreateForFixedStoragePartition(
+      source->GetBrowserContext(), url, config);
+}
+
+// Where the Space partitions live, relative to the profile directory; kept
+// when Chromium garbage-collects storage partitions it doesn't know.
+inline base::FilePath FlechaSpacePartitionsPath() {
+  return base::FilePath(FILE_PATH_LITERAL("Storage"))
+      .Append(FILE_PATH_LITERAL("ext"))
+      .AppendASCII(kFlechaSpacePartitionDomain);
+}
+
+#endif  // CHROME_BROWSER_FLECHA_FLECHA_SPACES_H_
