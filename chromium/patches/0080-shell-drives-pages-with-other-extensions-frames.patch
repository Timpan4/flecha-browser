+bool ExtensionDevToolsClientHost::MayStayAttachedWhileSubframeNavigates(
+    const GURL& url,
+    bool is_webui) {
+  // Flecha: the shell stays attached to a page while one of the page's frames
+  // loads another extension's page, such as a password manager's autofill
+  // dropdown. That frame runs in its extension's process, out of the page
+  // session's reach. MayAttachToURL(), which also guards storage, network and
+  // other access by origin, still refuses other extensions' URLs.
+  if (IsFlechaShell(extension_->id()) && !is_webui &&
+      url.SchemeIs(extensions::kExtensionScheme)) {
+    return true;
+  }
+  return MayAttachToURL(url, is_webui);
+}
+
 bool ExtensionDevToolsClientHost::IsTrusted() {
   return ExtensionIsTrusted(*extension_);
 }
