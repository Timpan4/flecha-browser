+++ b/chrome/browser/performance_manager/policies/flecha_tab_sleep_mark.cc
@@ -0,0 +1,35 @@
+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/performance_manager/policies/flecha_tab_sleep_mark.h"
+
+#include "base/memory/weak_ptr.h"
+#include "components/performance_manager/public/graph/page_node.h"
+#include "content/public/browser/web_contents.h"
+
+namespace performance_manager::policies {
+
+BASE_FEATURE(kFlechaTabSleepOwnsDiscards, base::FEATURE_ENABLED_BY_DEFAULT);
+const base::FeatureParam<base::TimeDelta> kFlechaMemorySaverTimeForTesting = {
+    &kFlechaTabSleepOwnsDiscards, "memory_saver_time_for_testing",
+    base::TimeDelta()};
+
+FlechaTabSleepMark::FlechaTabSleepMark(content::WebContents* contents)
+    : content::WebContentsUserData<FlechaTabSleepMark>(*contents) {}
+
+FlechaTabSleepMark::~FlechaTabSleepMark() = default;
+
+// static
+bool FlechaTabSleepMark::IsManaged(const PageNode* page_node) {
+  if (!base::FeatureList::IsEnabled(kFlechaTabSleepOwnsDiscards)) {
+    return false;
+  }
+  const base::WeakPtr<content::WebContents> contents =
+      page_node->GetWebContents();
+  return contents && FromWebContents(contents.get());
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(FlechaTabSleepMark);
+
+}  // namespace performance_manager::policies
