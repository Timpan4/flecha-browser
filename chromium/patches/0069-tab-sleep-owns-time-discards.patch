+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_FLECHA_TAB_SLEEP_MARK_H_
+#define CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_FLECHA_TAB_SLEEP_MARK_H_
+
+#include "base/feature_list.h"
+#include "base/metrics/field_trial_params.h"
+#include "base/time/time.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace performance_manager {
+class PageNode;
+}  // namespace performance_manager
+
+namespace performance_manager::policies {
+
+// Flecha's tab sleep (its shell, through
+// chrome.flechaPrivate.setTabSleepManaged) discards the tabs it marks after 4
+// hours of active use, as Dia does, so Memory Saver, whose timer counts any
+// time the device is awake, leaves them alone. With this disabled, Memory
+// Saver takes every tab again.
+BASE_DECLARE_FEATURE(kFlechaTabSleepOwnsDiscards);
+// For tests only: how long Memory Saver waits before discarding a background
+// tab, in place of its mode's time (zero, the default: its mode's).
+extern const base::FeatureParam<base::TimeDelta>
+    kFlechaMemorySaverTimeForTesting;
+
+// The mark on a tab. It ends with the page, so a discarded tab, which comes
+// back as a new page, needs marking again.
+class FlechaTabSleepMark
+    : public content::WebContentsUserData<FlechaTabSleepMark> {
+ public:
+  ~FlechaTabSleepMark() override;
+
+  // Whether Memory Saver leaves `page_node` to Flecha's tab sleep.
+  static bool IsManaged(const PageNode* page_node);
+
+ private:
+  friend class content::WebContentsUserData<FlechaTabSleepMark>;
+  explicit FlechaTabSleepMark(content::WebContents* contents);
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace performance_manager::policies
+
+#endif  // CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_FLECHA_TAB_SLEEP_MARK_H_
