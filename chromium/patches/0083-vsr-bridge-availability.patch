diff --git a/gpu/config/flecha_vsr_bridge_state.h b/gpu/config/flecha_vsr_bridge_state.h
new file mode 100644
--- /dev/null
+++ b/gpu/config/flecha_vsr_bridge_state.h
@@ -0,0 +1,14 @@
+// Flecha: process-local availability published by the pre-sandbox bridge setup.
+#ifndef GPU_CONFIG_FLECHA_VSR_BRIDGE_STATE_H_
+#define GPU_CONFIG_FLECHA_VSR_BRIDGE_STATE_H_
+
+#include "gpu/config/gpu_config_export.h"
+
+namespace gpu {
+
+GPU_CONFIG_EXPORT void SetFlechaVsrBridgeAvailableForProcess(bool available);
+GPU_CONFIG_EXPORT bool IsFlechaVsrBridgeAvailableForProcess();
+
+}  // namespace gpu
+
+#endif  // GPU_CONFIG_FLECHA_VSR_BRIDGE_STATE_H_
diff --git a/gpu/config/flecha_vsr_bridge_state.cc b/gpu/config/flecha_vsr_bridge_state.cc
new file mode 100644
--- /dev/null
+++ b/gpu/config/flecha_vsr_bridge_state.cc
@@ -0,0 +1,20 @@
+#include "gpu/config/flecha_vsr_bridge_state.h"
+
+#include <atomic>
+
+namespace gpu {
+namespace {
+
+std::atomic<bool> g_flecha_vsr_bridge_available{false};
+
+}  // namespace
+
+void SetFlechaVsrBridgeAvailableForProcess(bool available) {
+  g_flecha_vsr_bridge_available.store(available, std::memory_order_release);
+}
+
+bool IsFlechaVsrBridgeAvailableForProcess() {
+  return g_flecha_vsr_bridge_available.load(std::memory_order_acquire);
+}
+
+}  // namespace gpu
diff --git a/gpu/config/flecha_vsr_bridge_state_test.cc b/gpu/config/flecha_vsr_bridge_state_test.cc
new file mode 100644
--- /dev/null
+++ b/gpu/config/flecha_vsr_bridge_state_test.cc
@@ -0,0 +1,19 @@
+#include "gpu/config/flecha_vsr_bridge_state.h"
+
+#include <iostream>
+
+int main() {
+  if (gpu::IsFlechaVsrBridgeAvailableForProcess()) {
+    return 1;
+  }
+  gpu::SetFlechaVsrBridgeAvailableForProcess(true);
+  if (!gpu::IsFlechaVsrBridgeAvailableForProcess()) {
+    return 1;
+  }
+  gpu::SetFlechaVsrBridgeAvailableForProcess(false);
+  if (gpu::IsFlechaVsrBridgeAvailableForProcess()) {
+    return 1;
+  }
+  std::cout << "PASS: process-local VSR bridge availability transitions\n";
+  return 0;
+}
