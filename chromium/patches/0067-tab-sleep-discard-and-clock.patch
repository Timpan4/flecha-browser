+ExtensionFunction::ResponseAction FlechaPrivateDiscardTabFunction::Run() {
+  auto params = flecha_private::DiscardTab::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  base::WeakPtr<performance_manager::PageNode> page =
+      performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(
+          contents);
+  auto* helper =
+      page && performance_manager::PerformanceManager::IsAvailable()
+          ? performance_manager::PerformanceManager::GetGraph()
+                ->GetRegisteredObjectAs<
+                    performance_manager::policies::PageDiscardingHelper>()
+          : nullptr;
+  // MemorySaverModePolicy's own call when its timer fires: a PROACTIVE
+  // discard, which the DiscardEligibilityPolicy protections apply to. (An
+  // extension's chrome.tabs.discard is EXTERNAL, which skips them all.)
+  const bool discarded =
+      helper &&
+      helper->ImmediatelyDiscardMultiplePages(
+          {page.get()}, performance_manager::policies::
+                            DiscardEligibilityPolicy::DiscardReason::PROACTIVE);
+  return RespondNow(WithArguments(discarded));
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateGetLiveTicksFunction::Run() {
+  return RespondNow(WithArguments(
+      (base::LiveTicks::Now() - base::LiveTicks()).InMillisecondsF()));
+}
