+  }
+  action_anchor_id_ = id;
+  background->action_anchor()->SetBoundsRect(anchor);
+  background->action_anchor()->SetVisible(!anchor.IsEmpty());
+}
+
+bool FlechaFrameView::RunExtensionAction(const std::string& id,
+                                         const gfx::Rect& anchor) {
+  ToolbarActionViewModel* action = GetToolbarAction(id);
+  if (!action) {
+    return false;
+  }
+  // A second click on the button closes the popup, as on the toolbar. The
+  // press usually closed it already (it took focus from the popup).
+  const bool was_open = popup_at_press_ == id;
+  popup_at_press_.clear();
+  if (action->IsShowingPopup() || was_open) {
+    action->HidePopup();
+    return true;
+  }
+  // Only a popup points at the button. An action without one (on this tab) leaves no anchor
+  // behind for a later chrome.action.openPopup().
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(GetBrowserContext())
+          ->enabled_extensions()
+          .GetByID(id);
+  extensions::ExtensionAction* extension_action =
+      extension ? extensions::ExtensionActionManager::Get(GetBrowserContext())
+                      ->GetExtensionAction(*extension)
+                : nullptr;
+  const int tab_id = extensions::ExtensionTabUtil::GetTabId(
+      browser_view_->GetActiveWebContents());
+  SetActionAnchor(id, extension_action && extension_action->HasPopup(tab_id)
+                          ? anchor
+                          : gfx::Rect());
+  action->ExecuteUserAction(
+      ToolbarActionViewModel::InvocationSource::kToolbarButton);
+  return true;
+}
+
+bool FlechaFrameView::ShowExtensionActionMenu(const std::string& id,
+                                              const gfx::Rect& anchor) {
+  // GetContextMenu() replaces the action's menu model, which the last menu
+  // may still show.
+  action_menu_runner_.reset();
+  action_menu_model_ = nullptr;
+  ToolbarActionViewModel* action = GetToolbarAction(id);
+  ui::MenuModel* menu = action ? action->GetContextMenu(
+                                     extensions::ExtensionContextMenuModel::
+                                         ContextMenuSource::kToolbarAction)
+                               : nullptr;
+  if (!menu || !GetWidget()) {
+    return false;
+  }
+  gfx::Rect bounds = anchor;
+  bounds.Offset(GetBoundsInScreen().OffsetFromOrigin());
+  action_menu_model_ = action;
+  action_menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu, views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  action_menu_runner_->RunMenuAt(GetWidget(), nullptr, bounds,
+                                 views::MenuAnchorPosition::kTopLeft,
+                                 ui::mojom::MenuSourceType::kMouse);
+  return true;
+}
+
+void FlechaFrameView::OnExtensionActionModelDestroying(
+    const ToolbarActionViewModel* model) {
+  // Its menu model goes with it; an open menu would use it as it closes.
+  if (model == action_menu_model_) {
+    action_menu_runner_.reset();
+    action_menu_model_ = nullptr;
+  }
+}
