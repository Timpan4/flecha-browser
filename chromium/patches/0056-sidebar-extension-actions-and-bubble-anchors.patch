+views::View* FlechaFrameView::GetPageAnchorView() {
+  auto* background =
+      views::AsViewClass<FlechaFrameBackgroundView>(background_view());
+  return background && IsActive() ? background->page_anchor() : nullptr;
+}
+
+views::View* FlechaFrameView::GetPopupAnchorView(const std::string& action_id) {
+  auto* background =
+      views::AsViewClass<FlechaFrameBackgroundView>(background_view());
+  if (!background || !IsActive()) {
+    return nullptr;
+  }
+  // A keyboard shortcut or chrome.action.openPopup() has no button to point
+  // at; the popup drops into the page, where Chromium's toolbar would put it.
+  // The sidebar button is only for the popup its click opens: by a later
+  // open, the sidebar may have moved.
+  if (action_id != action_anchor_id_ ||
+      !background->action_anchor()->GetVisible()) {
+    return background->page_anchor();
+  }
+  action_anchor_id_.clear();
+  return background->action_anchor();
+}
+
+ToolbarActionViewModel* FlechaFrameView::GetToolbarAction(
+    const std::string& id) {
+  ExtensionsContainer* container =
+      ExtensionsContainer::From(*browser_view_->browser());
+  return container ? container->GetActionForId(id) : nullptr;
+}
+
+std::vector<FlechaExtensionAction> FlechaFrameView::GetExtensionActions() {
+  std::vector<FlechaExtensionAction> result;
+  auto* model =
+      ToolbarActionsModel::Get(Profile::FromBrowserContext(GetBrowserContext()));
+  if (!model || !model->actions_initialized()) {
+    return result;
+  }
+  std::vector<ToolbarActionsModel::ActionId> ids = model->pinned_action_ids();
+  for (const auto& id : model->action_ids()) {
+    if (!model->IsActionPinned(id)) {
+      ids.push_back(id);
+    }
+  }
+  content::WebContents* contents = browser_view_->GetActiveWebContents();
+  // The sidebar's action buttons are 28px (shell ui/styles.css #extensions);
+  // the icon is drawn for a 2x display, which the button scales down on 1x.
+  constexpr int kButtonSize = 28;
+  for (const auto& id : ids) {
+    ToolbarActionViewModel* action = GetToolbarAction(id);
+    if (!action) {
+      continue;
+    }
+    FlechaExtensionAction entry;
+    entry.id = id;
+    entry.name = base::UTF16ToUTF8(action->GetActionName());
+    entry.tooltip = base::UTF16ToUTF8(action->GetTooltip(contents));
+    entry.enabled = action->IsEnabled(contents);
+    entry.pinned = model->IsActionPinned(id);
+    const gfx::ImageSkia image =
+        action->GetIcon(contents, gfx::Size(kButtonSize, kButtonSize))
+            .Rasterize(GetColorProvider());
+    if (!image.isNull()) {
+      if (std::optional<std::vector<uint8_t>> png =
+              gfx::PNGCodec::EncodeBGRASkBitmap(
+                  image.GetRepresentation(2.0f).GetBitmap(),
+                  /*discard_transparency=*/false)) {
+        entry.icon = "data:image/png;base64," + base::Base64Encode(*png);
+      }
+    }
+    result.push_back(std::move(entry));
+  }
+  return result;
+}
