+ExtensionFunction::ResponseAction
+FlechaPrivateGetExtensionActionsFunction::Run() {
+  auto params = flecha_private::GetExtensionActions::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  FlechaFrameHost* host = HostForWindow(params->window_id, browser_context());
+  if (!host) {
+    return RespondNow(
+        Error(kNoWindowError, base::NumberToString(params->window_id)));
+  }
+  std::vector<flecha_private::ExtensionAction> actions;
+  for (FlechaExtensionAction& action : host->GetExtensionActions()) {
+    flecha_private::ExtensionAction& out = actions.emplace_back();
+    out.id = std::move(action.id);
+    out.name = std::move(action.name);
+    out.tooltip = std::move(action.tooltip);
+    out.icon = std::move(action.icon);
+    out.enabled = action.enabled;
+    out.pinned = action.pinned;
+  }
+  return RespondNow(ArgumentList(
+      flecha_private::GetExtensionActions::Results::Create(actions)));
+}
+
+namespace {
+
+gfx::Rect ToRect(const flecha_private::Bounds& bounds) {
+  return gfx::Rect(bounds.x, bounds.y, bounds.width, bounds.height);
+}
+
+constexpr char kNoActionError[] = "No extension action *.";
+
+}  // namespace
+
+ExtensionFunction::ResponseAction
+FlechaPrivateRunExtensionActionFunction::Run() {
+  auto params = flecha_private::RunExtensionAction::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  FlechaFrameHost* host = HostForWindow(params->window_id, browser_context());
+  if (!host) {
+    return RespondNow(
+        Error(kNoWindowError, base::NumberToString(params->window_id)));
+  }
+  if (!host->RunExtensionAction(params->id, ToRect(params->anchor))) {
+    return RespondNow(Error(kNoActionError, params->id));
+  }
+  return RespondNow(NoArguments());
+}
+
