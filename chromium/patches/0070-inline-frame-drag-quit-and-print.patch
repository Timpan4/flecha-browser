+ExtensionFunction::ResponseAction FlechaPrivateQuitFunction::Run() {
+  // After answering: quitting closes this function's renderer too.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&chrome::AttemptUserExit));
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction FlechaPrivatePrintFunction::Run() {
+  auto params = flecha_private::Print::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  // Chromium's Print prints the active tab of a window, as Ctrl+P does.
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!window ||
+      window->GetTabStripModel()->GetActiveWebContents() != contents) {
+    return RespondNow(Error("The tab is not the active tab of its window"));
+  }
+  chrome::Print(window);
+  return RespondNow(NoArguments());
+}
+
