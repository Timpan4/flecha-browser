+// A shortcut's modifier key is held: its release (or the window losing focus
+// first) ends a run of the shortcut, like a recent-tabs switcher's.
+class FlechaFrameView::ShortcutRelease : public ui::EventObserver,
+                                         public views::WidgetObserver {
+ public:
+  ShortcutRelease(FlechaFrameView* frame,
+                  const std::string& command,
+                  int modifiers)
+      : frame_(frame), command_(command), modifiers_(modifiers) {
+    views::Widget* widget = frame->GetWidget();
+    monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, widget->GetNativeWindow(), {ui::EventType::kKeyReleased});
+    widget_observation_.Observe(widget);
+  }
+
+  const std::string& command() const { return command_; }
+  int modifiers() const { return modifiers_; }
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override {
+    if (!event.IsKeyEvent()) {
+      return;
+    }
+    const ui::KeyboardCode key = event.AsKeyEvent()->key_code();
+    const bool released =
+        ((modifiers_ & ui::EF_CONTROL_DOWN) &&
+         (key == ui::VKEY_CONTROL || key == ui::VKEY_LCONTROL ||
+          key == ui::VKEY_RCONTROL)) ||
+        ((modifiers_ & ui::EF_ALT_DOWN) &&
+         (key == ui::VKEY_MENU || key == ui::VKEY_LMENU ||
+          key == ui::VKEY_RMENU)) ||
+        ((modifiers_ & ui::EF_COMMAND_DOWN) &&
+         (key == ui::VKEY_COMMAND || key == ui::VKEY_RWIN));
+    if (released) {
+      End();
+    }
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (!active) {
+      End();
+    }
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    widget_observation_.Reset();
+    monitor_.reset();
+  }
+
+ private:
+  // Not from inside the monitor's own dispatch: the frame deletes this soon.
+  void End() {
+    if (ended_) {
+      return;
+    }
+    ended_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&FlechaFrameView::EndShortcutRelease,
+                                  frame_->weak_factory_.GetWeakPtr()));
+  }
+
+  raw_ptr<FlechaFrameView> frame_;
+  const std::string command_;
+  const int modifiers_;
+  bool ended_ = false;
+  std::unique_ptr<views::EventMonitor> monitor_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+};
