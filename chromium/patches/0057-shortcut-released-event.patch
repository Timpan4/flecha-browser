+void FlechaFrameView::WatchShortcutRelease(const std::string& command,
+                                           int modifiers) {
+  constexpr int kHeldModifiers =
+      ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN;
+  if (!(modifiers & kHeldModifiers) || !GetWidget()) {
+    return;
+  }
+  // Another shortcut on the same held modifiers (Control-Tab, then
+  // Control-Shift-Tab) continues the run; its release names the first.
+  if (shortcut_release_ &&
+      shortcut_release_->modifiers() == (modifiers & kHeldModifiers)) {
+    return;
+  }
+  EndShortcutRelease();
+  shortcut_release_ = std::make_unique<ShortcutRelease>(
+      this, command, modifiers & kHeldModifiers);
+}
+
+void FlechaFrameView::EndShortcutRelease() {
+  if (!shortcut_release_) {
+    return;
+  }
+  const std::string command = shortcut_release_->command();
+  shortcut_release_.reset();
+  base::ListValue args;
+  args.Append(command);
+  args.Append(GetWindowId());
+  DispatchFlechaShellEvent(Profile::FromBrowserContext(GetBrowserContext()),
+                           "flechaPrivate.onShortcutReleased",
+                           std::move(args));
+}
