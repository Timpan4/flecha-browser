+ExtensionFunction::ResponseAction
+FlechaPrivateSetSidebarInPageFullscreenFunction::Run() {
+  auto params =
+      flecha_private::SetSidebarInPageFullscreen::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  FlechaFrameHost* host =
+      params->window_id ? HostForWindow(*params->window_id, browser_context())
+                        : HostForContents(GetSenderWebContents());
+  if (!host) {
+    return RespondNow(
+        Error(kNoWindowError, params->window_id
+                                  ? base::NumberToString(*params->window_id)
+                                  : "(none)"));
+  }
+  host->SetSidebarInPageFullscreen(params->show);
+  return RespondNow(NoArguments());
+}
+
