+void FlechaFrameView::TellPageItLeftFullscreen() {
+  if (views::WebView* page = browser_view_->GetActiveContentsWebView();
+      page && page->web_contents()) {
+    if (content::RenderWidgetHost* widget = page->web_contents()
+                                                ->GetPrimaryMainFrame()
+                                                ->GetRenderWidgetHost()) {
+      widget->SynchronizeVisualProperties();
+    }
+  }
+}
+
+void FlechaFrameView::WatchPageFullscreen() {
+  if (page_fullscreen_subscription_) {
+    return;
+  }
+  // The browser's features come after its view (and this frame).
+  ExclusiveAccessManager* access =
+      ExclusiveAccessManager::From(browser_view_->browser());
+  if (!access) {
+    return;
+  }
+  page_fullscreen_subscription_ =
+      access->fullscreen_controller()->RegisterOnFullscreenStateChanged(
+          base::BindRepeating(&FlechaFrameView::OnWindowFullscreenChanged,
+                              base::Unretained(this)));
+}
