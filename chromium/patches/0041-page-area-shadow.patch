 BEGIN_METADATA(FlechaFrameBackgroundView)
 END_METADATA
 
+// The window background: the Space's colour, and under the page area a soft
+// drop shadow, as in Arc, with no outline. The page area (the view's insets)
+// covers the shape itself; only its shadow shows, in the gap around it.
+class FlechaFrameBackground : public views::Background {
+ public:
+  explicit FlechaFrameBackground(const FlechaFrameState& state)
+      : state_(state) {}
+
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    canvas->DrawColor(state_.background);
+    gfx::Rect page = view->GetLocalBounds();
+    page.Inset(view->GetInsets());
+    // A page area that fills the window (fullscreen, sidebar hidden) has no
+    // gap to cast a shadow in.
+    if (page.IsEmpty() || page == view->GetLocalBounds()) {
+      return;
+    }
+    // Light: a close, crisp shadow and a wide, faint one, both of Flecha's
+    // ink. Dark (a dark Space colour): stronger, on black.
+    const bool dark = color_utils::IsDark(state_.background);
+    const SkColor ink = dark ? SK_ColorBLACK : SkColorSetRGB(0x0b, 0x25, 0x45);
+    const std::vector<gfx::ShadowValue> shadows = {
+        gfx::ShadowValue(gfx::Vector2d(0, 1), 3,
+                         SkColorSetA(ink, dark ? 0x59 : 0x1a)),
+        gfx::ShadowValue(gfx::Vector2d(0, 4), 14,
+                         SkColorSetA(ink, dark ? 0x40 : 0x0f)),
+    };
+    // Beside the docked sidebar (opaque, over the window's left part) a halo
+    // would show only in the gaps above and below the page, cut straight at
+    // the sidebar's edge; keep the shape that far in on that side instead.
+    gfx::RectF shape(page);
+    if (!state_.flechinha &&
+        state_.sidebar == FlechaFrameState::Sidebar::kDocked) {
+      shape.Inset(gfx::InsetsF::TLBR(0, 14, 0, 0));
+    }
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(dark ? SkColorSetRGB(0x1f, 0x1f, 0x1f) : SK_ColorWHITE);
+    flags.setLooper(gfx::CreateShadowDrawLooper(shadows));
+    canvas->DrawRoundRect(shape, kFlechaPageCornerRadius, flags);
+  }
+
+ private:
+  const FlechaFrameState state_;
+};
+
 // Wide enough to cover any window, for an overlay.
 constexpr int kOverlayWidth = 1 << 20;
 
