+// Flecha: sidebar-visible page fullscreen ends when its tab loses activation.
+// Captured tabs retain Chromium's independent fullscreen-within-tab behavior.
+void FullscreenController::OnTabDeactivated(WebContents* web_contents) {
+  if (IsFullscreenWithinTab(web_contents) &&
+      !web_contents->IsBeingVisiblyCaptured()) {
+    web_contents->ExitFullscreen(/*will_cause_resize=*/false);
+    return;
+  }
+  ExclusiveAccessControllerBase::OnTabDeactivated(web_contents);
+}
+
+void FullscreenController::UpdateFullscreenWithinTab(
+    WebContents* web_contents) {
+  if (!web_contents || !IsFullscreenWithinTab(web_contents) ||
+      web_contents->IsBeingVisiblyCaptured() ||
+      exclusive_access_manager()->context()->ShouldKeepFullscreenWithinTab()) {
+    return;
+  }
+  // The page's fullscreen element stays as it is. Its main frame stands in for
+  // the requesting frame, which the within-tab path does not keep.
+  content::RenderFrameHost* frame = web_contents->GetPrimaryMainFrame();
+  if (!CanEnterFullscreenModeForTab(frame)) {
+    return;
+  }
+  FullscreenWithinTabHelper::RemoveForWebContents(web_contents);
+  EnterFullscreenModeForTab(frame, FullscreenTabParams());
+}
