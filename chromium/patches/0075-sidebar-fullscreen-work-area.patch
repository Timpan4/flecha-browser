+// Flecha: page fullscreen beside the sidebar must not fullscreen the OS window.
+TEST_F(FullscreenControllerStateUnitTest,
+       FlechaSidebarKeepsPageFullscreenWithinWindow) {
+  AddTab();
+  window_->set_keep_fullscreen_within_tab(true);
+  ASSERT_TRUE(InvokeEvent(ENTER_TAB_FULLSCREEN));
+  EXPECT_TRUE(GetTab(0)->IsFullscreen());
+  EXPECT_EQ(
+      content::FullscreenMode::kPseudoContent,
+      GetFullscreenController()->GetFullscreenState(GetTab(0)).target_mode);
+  EXPECT_EQ(FullscreenControllerTestWindow::kNormal, window_->state());
+  EXPECT_FALSE(GetFullscreenController()->IsWindowFullscreenForTabOrPending());
+
+  EXPECT_TRUE(GetFullscreenController()->HandleUserPressedEscape());
+  EXPECT_FALSE(GetTab(0)->IsFullscreen());
+  EXPECT_EQ(FullscreenControllerTestWindow::kNormal, window_->state());
+}
+
+TEST_F(FullscreenControllerStateUnitTest,
+       FlechaSidebarFullscreenExitsWhenSwitchingTabs) {
+  auto* old_tab = AddTab();
+  AddTab();
+  ActivateTab(0);
+  window_->set_keep_fullscreen_within_tab(true);
+  ASSERT_TRUE(InvokeEvent(ENTER_TAB_FULLSCREEN));
+  ASSERT_TRUE(old_tab->IsFullscreen());
+  ActivateTab(1);
+  EXPECT_FALSE(old_tab->IsFullscreen());
+  EXPECT_FALSE(GetFullscreenController()->IsFullscreenWithinTab(old_tab));
+  EXPECT_FALSE(GetFullscreenController()->IsFullscreenWithinTab(GetTab(1)));
+  EXPECT_EQ(FullscreenControllerTestWindow::kNormal, window_->state());
+}
