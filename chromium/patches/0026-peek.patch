+// The window a Peek call is about: `window_id`, or Flecha's main window.
+FlechaFrameHost* PeekHost(const std::optional<int>& window_id,
+                          content::BrowserContext* context) {
+  if (window_id) {
+    FlechaFrameHost* host = HostForWindow(*window_id, context);
+    return host && !host->IsFlechinha() ? host : nullptr;
+  }
+  return FlechaFrameHost::Main(
+      Profile::FromBrowserContext(context)->GetOriginalProfile());
+}
