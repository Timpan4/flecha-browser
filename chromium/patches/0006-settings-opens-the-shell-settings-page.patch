 void ShowSettings(BrowserWindowInterface* browser) {
+  // Flecha: Settings (Cmd+, and the app menu) is the shell's settings page.
+  // chrome://settings stays reachable by typing it, and Chromium's own
+  // sub-pages (clear browsing data, passwords, ...) still open there.
+  if (extensions::ExtensionRegistry::Get(browser->GetProfile())
+          ->enabled_extensions()
+          .Contains(kFlechaShellExtensionId)) {
+    base::RecordAction(UserMetricsAction("ShowOptions"));
+    FocusWebContents(browser);
+    ShowSingletonTabOverwritingNTP(
+        browser,
+        GURL(base::StrCat({extensions::kExtensionScheme,
+                           url::kStandardSchemeSeparator,
+                           kFlechaShellExtensionId, "/settings.html"})));
+    return;
+  }
   ShowSettingsSubPage(browser, std::string());
 }
 
