+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/flecha/flecha_frame_host.h"
+
+#include "base/no_destructor.h"
+
+namespace {
+
+std::vector<FlechaFrameHost*>& Hosts() {
+  static base::NoDestructor<std::vector<FlechaFrameHost*>> hosts;
+  return *hosts;
+}
+
+}  // namespace
+
+// static
+const std::vector<FlechaFrameHost*>& FlechaFrameHost::All() {
+  return Hosts();
+}
+
+// static
+std::optional<FlechaFrameState>& FlechaFrameHost::DefaultState() {
+  static std::optional<FlechaFrameState> state;
+  return state;
+}
+
+FlechaFrameHost::FlechaFrameHost() {
+  Hosts().push_back(this);
+}
+
+FlechaFrameHost::~FlechaFrameHost() {
+  std::erase(Hosts(), this);
+}
