+#include "extensions/browser/extension_function.h"
+
+namespace extensions {
+
+// chrome.flechaPrivate: what Flecha's browser gives its shell, and only the
+// shell (see flecha_frame_host.h). Its functions use the UNKNOWN histogram
+// value so that Flecha's patches stay off Chromium's histogram enums.
+
+class FlechaPrivateSetFrameFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("flechaPrivate.setFrame", UNKNOWN)
+
+ protected:
+  ~FlechaPrivateSetFrameFunction() override = default;
+  ResponseAction Run() override;
+};
+
+class FlechaPrivateFocusFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("flechaPrivate.focus", UNKNOWN)
+
+ protected:
+  ~FlechaPrivateFocusFunction() override = default;
+  ResponseAction Run() override;
+};
+
+class FlechaPrivateGetWindowIdFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("flechaPrivate.getWindowId", UNKNOWN)
+
+ protected:
+  ~FlechaPrivateGetWindowIdFunction() override = default;
+  ResponseAction Run() override;
+};
+
+}  // namespace extensions
