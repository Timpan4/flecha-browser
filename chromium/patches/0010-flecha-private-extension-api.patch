+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/flecha_private/flecha_private_api.h"
+
+#include <optional>
+#include <string>
+
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/flecha/flecha_frame_host.h"
+#include "chrome/common/extensions/api/flecha_private.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extensions_browser_client.h"
+
+namespace extensions {
+
+namespace {
+
+namespace flecha_private = api::flecha_private;
+
+constexpr char kNoWindowError[] = "No Flecha window with id *.";
+constexpr char kNotAFramePageError[] = "The caller is not a frame page.";
+constexpr char kBadColorError[] = "background must be #rrggbb.";
+
+std::optional<SkColor> ParseColor(const std::string& text) {
+  uint32_t rgb = 0;
+  if (text.size() != 7 || text[0] != '#' ||
+      !base::HexStringToUInt(std::string_view(text).substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
+}
+
+bool SameProfile(FlechaFrameHost* host, content::BrowserContext* context) {
+  return ExtensionsBrowserClient::Get()->IsSameContext(
+      host->GetBrowserContext(), context);
+}
+
+FlechaFrameHost* HostForWindow(int window_id,
+                               content::BrowserContext* context) {
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (host->GetWindowId() == window_id && SameProfile(host, context)) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+FlechaFrameHost* HostForContents(content::WebContents* contents) {
+  if (!contents) {
+    return nullptr;
+  }
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (host->GetFrameContents() == contents) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+FlechaFrameHost* ActiveHost(content::BrowserContext* context) {
+  FlechaFrameHost* fallback = nullptr;
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (!SameProfile(host, context)) {
+      continue;
+    }
+    if (host->IsActiveWindow()) {
+      return host;
+    }
+    fallback = host;
+  }
+  return fallback;
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction FlechaPrivateSetFrameFunction::Run() {
+  auto params = flecha_private::SetFrame::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  FlechaFrameState state;
+  switch (params->state.sidebar) {
+    case flecha_private::SidebarMode::kDocked:
+      state.sidebar = FlechaFrameState::Sidebar::kDocked;
+      break;
+    case flecha_private::SidebarMode::kHidden:
+      state.sidebar = FlechaFrameState::Sidebar::kHidden;
+      break;
+    case flecha_private::SidebarMode::kFloating:
+      state.sidebar = FlechaFrameState::Sidebar::kFloating;
+      break;
+    case flecha_private::SidebarMode::kNone:
+      return RespondNow(BadMessage());
+  }
+  state.overlay = params->state.overlay;
+  std::optional<SkColor> background = ParseColor(params->state.background);
+  if (!background) {
+    return RespondNow(Error(kBadColorError));
+  }
+  state.background = *background;
+
+  if (params->window_id) {
+    FlechaFrameHost* host = HostForWindow(*params->window_id, browser_context());
+    if (!host) {
+      return RespondNow(Error(kNoWindowError,
+                              base::NumberToString(*params->window_id)));
+    }
+    host->SetFrameState(state);
+    return RespondNow(NoArguments());
+  }
+
+  FlechaFrameHost::DefaultState() = state;
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    if (SameProfile(host, browser_context())) {
+      host->SetFrameState(state);
+    }
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateFocusFunction::Run() {
+  auto params = flecha_private::Focus::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  FlechaFrameHost* host = nullptr;
+  if (params->window_id) {
+    host = HostForWindow(*params->window_id, browser_context());
+    if (!host) {
+      return RespondNow(Error(kNoWindowError,
+                              base::NumberToString(*params->window_id)));
+    }
+  } else {
+    host = HostForContents(GetSenderWebContents());
+    if (!host) {
+      host = ActiveHost(browser_context());
+    }
+  }
+  if (!host) {
+    return RespondNow(Error(kNoWindowError, "(none)"));
+  }
+
+  switch (params->target) {
+    case flecha_private::FocusTarget::kFrame:
+      host->FocusFrame();
+      break;
+    case flecha_private::FocusTarget::kPage:
+      host->FocusPage();
+      break;
+    case flecha_private::FocusTarget::kNone:
+      return RespondNow(BadMessage());
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateGetWindowIdFunction::Run() {
+  FlechaFrameHost* host = HostForContents(GetSenderWebContents());
+  if (!host) {
+    return RespondNow(Error(kNotAFramePageError));
+  }
+  return RespondNow(WithArguments(host->GetWindowId()));
+}
+
+}  // namespace extensions
