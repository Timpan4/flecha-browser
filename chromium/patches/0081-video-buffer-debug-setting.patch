+// Flecha: distinguish the saved preference from the startup mode and an
+// explicit launcher override. Saving never changes the running browser.
+flecha_private::DebugSettings DebugSettingsOf() {
+  flecha_private::DebugSettings state;
+  state.disable_gpu_memory_buffer_video_frames =
+      g_browser_process->local_state()->GetBoolean(
+          flecha::kDisableVideoGpuMemoryBuffers);
+  state.video_buffer_workaround_active =
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kDisableGpuMemoryBufferVideoFrames);
+  state.video_buffer_workaround_forced =
+      flecha::g_video_buffer_workaround_forced;
+  return state;
+}
