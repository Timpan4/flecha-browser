 namespace flecha {
 inline constexpr char kVsrEnabled[] = "flecha.vsr.enabled";
 inline constexpr char kVsrQuality[] = "flecha.vsr.quality";
 inline constexpr char kVsrMaxHeight[] = "flecha.vsr.max_output_height";
+// Flecha: the debug workaround is opt-in and takes effect at browser startup.
+inline constexpr char kDisableVideoGpuMemoryBuffers[] =
+    "flecha.debug.disable_gpu_memory_buffer_video_frames";
+inline bool g_video_buffer_workaround_forced = false;
 
 inline void RegisterVideoPreferences(PrefRegistrySimple* registry) {
   registry->RegisterBooleanPref(kVsrEnabled, true);
   registry->RegisterIntegerPref(kVsrQuality, 2);
   registry->RegisterIntegerPref(kVsrMaxHeight, 1440);
+  registry->RegisterBooleanPref(kDisableVideoGpuMemoryBuffers, false);
 }
+
+// Call before child processes start. Preserve explicit launcher flags and keep
+// preference edits from changing the mode halfway through a browser session.
+inline void ApplyVideoDebugPreference(PrefService* prefs,
+                                      base::CommandLine* command) {
+  g_video_buffer_workaround_forced =
+      command->HasSwitch(switches::kDisableGpuMemoryBufferVideoFrames);
+  if (prefs->GetBoolean(kDisableVideoGpuMemoryBuffers)) {
+    command->AppendSwitch(switches::kDisableGpuMemoryBufferVideoFrames);
+  }
+}
