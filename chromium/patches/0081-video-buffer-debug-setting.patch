+}
+
+ExtensionFunction::ResponseAction
+FlechaPrivateSetVideoBufferWorkaroundFunction::Run() {
+  auto params =
+      flecha_private::SetVideoBufferWorkaround::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  if (flecha::g_video_buffer_workaround_forced) {
+    return RespondNow(
+        Error("The video-buffer workaround is enabled by a "
+              "command-line flag."));
+  }
+  auto* prefs = g_browser_process->local_state();
+  prefs->SetBoolean(flecha::kDisableVideoGpuMemoryBuffers, params->enabled);
+  prefs->CommitPendingWrite();
+  return RespondNow(
+      ArgumentList(flecha_private::SetVideoBufferWorkaround::Results::Create(
+          DebugSettingsOf())));
+}
