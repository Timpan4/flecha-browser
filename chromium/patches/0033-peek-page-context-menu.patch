+// static
+bool FlechaFrameHost::IsPeek(const content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  for (FlechaFrameHost* host : Hosts()) {
+    if (host->GetPeekContents() == contents) {
+      return true;
+    }
+  }
+  return false;
+}
+
 FlechaFrameHost::FlechaFrameHost() {
   Hosts().push_back(this);
 }
