+#ifndef CHROME_BROWSER_EXTENSIONS_API_FLECHA_PRIVATE_FLECHA_AGENT_TAB_H_
+#define CHROME_BROWSER_EXTENSIONS_API_FLECHA_PRIVATE_FLECHA_AGENT_TAB_H_
+
+#include <optional>
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "extensions/common/extension_id.h"
+
+namespace extensions {
+
+// A tab a coding agent drives (flechaPrivate.setAgentTab()). Only one
+// extension, Flecha's shell, runs scripts in its frames. Each frame gets the
+// limit as it is created (ExtensionFrameHelper::SetFlechaAgentTab()), and a
+// discarded tab hands the mark to the page that replaces it.
+class FlechaAgentTab : public content::WebContentsObserver,
+                       public content::WebContentsUserData<FlechaAgentTab> {
+ public:
+  // Marks `contents` so that only `only_extension_id` runs scripts in it, or,
+  // with null, takes the mark back. Frames already live get the change now.
+  static void Set(content::WebContents* contents,
+                  std::optional<ExtensionId> only_extension_id);
+
+  FlechaAgentTab(const FlechaAgentTab&) = delete;
+  FlechaAgentTab& operator=(const FlechaAgentTab&) = delete;
+  ~FlechaAgentTab() override;
+
+ private:
+  friend class content::WebContentsUserData<FlechaAgentTab>;
+
+  FlechaAgentTab(content::WebContents* contents, ExtensionId only_extension_id);
+
+  // content::WebContentsObserver:
+  void RenderFrameCreated(content::RenderFrameHost* host) override;
+  void AboutToBeDiscarded(content::WebContents* new_contents) override;
+
+  const ExtensionId only_extension_id_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_FLECHA_PRIVATE_FLECHA_AGENT_TAB_H_
