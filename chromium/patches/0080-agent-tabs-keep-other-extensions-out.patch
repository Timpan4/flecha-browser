+ExtensionFunction::ResponseAction FlechaPrivateSetAgentTabFunction::Run() {
+  auto params = flecha_private::SetAgentTab::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  TabHelper* tab_helper = TabHelper::FromWebContents(contents);
+  if (!tab_helper) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  tab_helper->SetFlechaAgentTab(params->agent
+                                    ? std::optional<ExtensionId>(extension_id())
+                                    : std::nullopt);
+  return RespondNow(NoArguments());
+}
