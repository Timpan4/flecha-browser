+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/flecha_private/flecha_agent_tab.h"
+
+#include <utility>
+
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extension_web_contents_observer.h"
+#include "extensions/common/mojom/frame.mojom.h"
+
+namespace extensions {
+
+namespace {
+
+void SendToFrame(content::WebContents* contents,
+                 content::RenderFrameHost* host,
+                 const std::optional<ExtensionId>& only_extension_id) {
+  if (!host->IsRenderFrameLive()) {
+    return;
+  }
+  auto* observer = ExtensionWebContentsObserver::GetForWebContents(contents);
+  mojom::LocalFrame* frame = observer ? observer->GetLocalFrame(host) : nullptr;
+  if (frame) {
+    frame->SetFlechaAgentTab(only_extension_id);
+  }
+}
+
+}  // namespace
+
+// static
+void FlechaAgentTab::Set(content::WebContents* contents,
+                         std::optional<ExtensionId> only_extension_id) {
+  contents->RemoveUserData(UserDataKey());
+  if (only_extension_id) {
+    CreateForWebContents(contents, *only_extension_id);
+  }
+  contents->ForEachRenderFrameHost([&](content::RenderFrameHost* host) {
+    SendToFrame(contents, host, only_extension_id);
+  });
+}
+
+FlechaAgentTab::FlechaAgentTab(content::WebContents* contents,
+                               ExtensionId only_extension_id)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<FlechaAgentTab>(*contents),
+      only_extension_id_(std::move(only_extension_id)) {}
+
+FlechaAgentTab::~FlechaAgentTab() = default;
+
+void FlechaAgentTab::RenderFrameCreated(content::RenderFrameHost* host) {
+  // Sent before the frame commits a navigation: the commit goes over the same
+  // channel, after this.
+  SendToFrame(web_contents(), host, only_extension_id_);
+}
+
+void FlechaAgentTab::AboutToBeDiscarded(content::WebContents* new_contents) {
+  // The replacement has no frames yet; it sends the mark as they are created.
+  Set(new_contents, only_extension_id_);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(FlechaAgentTab);
+
+}  // namespace extensions
