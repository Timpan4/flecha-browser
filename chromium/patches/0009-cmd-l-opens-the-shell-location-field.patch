+#ifndef CHROME_BROWSER_FLECHA_FLECHA_SHELL_COMMANDS_H_
+#define CHROME_BROWSER_FLECHA_FLECHA_SHELL_COMMANDS_H_
+
+#include <memory>
+#include <string_view>
+#include <utility>
+
+#include "base/memory/scoped_refptr.h"
+#include "chrome/browser/flecha/flecha_shell.h"
+#include "chrome/browser/profiles/profile.h"
+#include "extensions/browser/event_router.h"
+#include "extensions/browser/extension_event_histogram_value.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/common/event_args.h"
+
+// Browser commands that Flecha hands to the shell (chromium/shell) instead of
+// Chromium's own UI. Each is one of the "commands" in the shell's manifest,
+// and reaches it as chrome.commands.onCommand(name), the way an extension
+// keyboard shortcut would.
+inline constexpr char kFlechaOpenLocationCommand[] = "flecha-open-location";
+
+inline void DispatchFlechaShellCommand(Profile* profile,
+                                       std::string_view command) {
+  profile = profile->GetOriginalProfile();
+  if (!extensions::ExtensionRegistry::Get(profile)
+           ->enabled_extensions()
+           .Contains(kFlechaShellExtensionId)) {
+    return;
+  }
+  auto args = base::MakeRefCounted<extensions::EventArgs>();
+  args->data.Append(command);
+  auto event = std::make_unique<extensions::Event>(
+      extensions::events::COMMANDS_ON_COMMAND, "commands.onCommand",
+      std::move(args), profile);
+  event->user_gesture = extensions::EventRouter::UserGestureState::kEnabled;
+  extensions::EventRouter::Get(profile)->DispatchEventToExtension(
+      kFlechaShellExtensionId, std::move(event));
+}
+
+#endif  // CHROME_BROWSER_FLECHA_FLECHA_SHELL_COMMANDS_H_
