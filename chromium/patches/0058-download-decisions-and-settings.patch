+// ---- downloads ---------------------------------------------------------------
+
+namespace {
+
+constexpr char kNoDownloadError[] = "No download with id *.";
+constexpr char kNotHeldError[] = "Download * isn't waiting for a decision.";
+
+// A download held for a decision: dangerous, or insecure (plain HTTP).
+const char* WarningKind(download::DownloadItem* item) {
+  if (item->GetState() != download::DownloadItem::IN_PROGRESS) {
+    return nullptr;
+  }
+  if (item->IsInsecure()) {
+    return "insecure";
+  }
+  return item->IsDangerous() ? "dangerous" : nullptr;
+}
+
+download::DownloadItem* FindDownload(content::BrowserContext* context, int id) {
+  return id < 0 ? nullptr : context->GetDownloadManager()->GetDownload(id);
+}
+
+flecha_private::DownloadSettings DownloadSettingsOf(
+    content::BrowserContext* context) {
+  DownloadPrefs* prefs = DownloadPrefs::FromBrowserContext(context);
+  flecha_private::DownloadSettings settings;
+  settings.folder = prefs->DownloadPath().AsUTF8Unsafe();
+  settings.ask_where_to_save = prefs->PromptForDownload();
+  return settings;
+}
+
+// The platform's folder chooser for the downloads folder; answers the call
+// that opened it, then deletes itself.
+class DownloadsFolderChooser : public ui::SelectFileDialog::Listener {
+ public:
+  DownloadsFolderChooser(
+      scoped_refptr<FlechaPrivateChooseDownloadsFolderFunction> function,
+                         content::BrowserContext* context)
+      : function_(std::move(function)), context_(context) {}
+  ~DownloadsFolderChooser() override {
+    if (dialog_) {
+      dialog_->ListenerDestroyed();
+    }
+  }
+
+  void Show(gfx::NativeWindow parent) {
+    dialog_ = ui::SelectFileDialog::Create(this, /*policy=*/nullptr);
+    dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_FOLDER, std::u16string(),
+        DownloadPrefs::FromBrowserContext(context_)->DownloadPath(),
+        /*file_types=*/nullptr, /*file_type_index=*/0,
+        base::FilePath::StringType(), parent);
+  }
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override {
+    DownloadPrefs::FromBrowserContext(context_)->SetDownloadPath(file.path());
+    Finish();
+  }
+  void FileSelectionCanceled() override { Finish(); }
+
+ private:
+  void Finish() {
+    function_->Answer();
+    delete this;
+  }
+
+  scoped_refptr<FlechaPrivateChooseDownloadsFolderFunction> function_;
+  raw_ptr<content::BrowserContext> context_;
+  scoped_refptr<ui::SelectFileDialog> dialog_;
+};
+
+}  // namespace
+
+ExtensionFunction::ResponseAction
+FlechaPrivateGetDownloadWarningsFunction::Run() {
+  download::SimpleDownloadManager::DownloadVector items;
+  browser_context()->GetDownloadManager()->GetAllDownloads(&items);
+  std::vector<flecha_private::DownloadWarning> warnings;
+  for (download::DownloadItem* item : items) {
+    if (const char* kind = WarningKind(item)) {
+      flecha_private::DownloadWarning& warning = warnings.emplace_back();
+      warning.id = static_cast<int>(item->GetId());
+      warning.kind = kind;
+    }
+  }
+  return RespondNow(ArgumentList(
+      flecha_private::GetDownloadWarnings::Results::Create(warnings)));
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateKeepDownloadFunction::Run() {
+  auto params = flecha_private::KeepDownload::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  download::DownloadItem* item = FindDownload(browser_context(), params->id);
+  if (!item) {
+    return RespondNow(Error(kNoDownloadError, base::NumberToString(params->id)));
+  }
+  const char* kind = WarningKind(item);
+  if (!kind) {
+    return RespondNow(Error(kNotHeldError, base::NumberToString(params->id)));
+  }
+  if (item->IsInsecure()) {
+    item->ValidateInsecureDownload();
+  } else {
+    item->ValidateDangerousDownload();
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateDiscardDownloadFunction::Run() {
+  auto params = flecha_private::DiscardDownload::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  download::DownloadItem* item = FindDownload(browser_context(), params->id);
+  if (!item) {
+    return RespondNow(Error(kNoDownloadError, base::NumberToString(params->id)));
+  }
+  if (!WarningKind(item)) {
+    return RespondNow(Error(kNotHeldError, base::NumberToString(params->id)));
+  }
+  // Deletes the partial file and drops the download from the list.
+  item->Remove();
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction
+FlechaPrivateGetDownloadSettingsFunction::Run() {
+  return RespondNow(
+      ArgumentList(flecha_private::GetDownloadSettings::Results::Create(
+          DownloadSettingsOf(browser_context()))));
+}
+
+void FlechaPrivateChooseDownloadsFolderFunction::Answer() {
+  Respond(
+      ArgumentList(flecha_private::ChooseDownloadsFolder::Results::Create(
+          DownloadSettingsOf(browser_context()))));
+}
+
+ExtensionFunction::ResponseAction
+FlechaPrivateChooseDownloadsFolderFunction::Run() {
+  FlechaFrameHost* host = FlechaFrameHost::Main(browser_context());
+  ui::BaseWindow* window =
+      host ? host->GetBrowserWindowInterface()->GetWindow() : nullptr;
+  if (!window) {
+    return RespondNow(Error(kNoWindowError, "(main)"));
+  }
+  // Deletes itself once answered.
+  (new DownloadsFolderChooser(this, browser_context()))
+      ->Show(window->GetNativeWindow());
+  return RespondLater();
+}
+
+ExtensionFunction::ResponseAction FlechaPrivateSetAskWhereToSaveFunction::Run() {
+  auto params = flecha_private::SetAskWhereToSave::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  Profile::FromBrowserContext(browser_context())
+      ->GetPrefs()
+      ->SetBoolean(prefs::kPromptForDownload, params->ask);
+  return RespondNow(
+      ArgumentList(flecha_private::SetAskWhereToSave::Results::Create(
+          DownloadSettingsOf(browser_context()))));
+}
