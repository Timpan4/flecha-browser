+ExtensionFunction::ResponseAction FlechaPrivateShowFindBarFunction::Run() {
+  auto params = flecha_private::ShowFindBar::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  FlechaFrameHost* host =
+      params->window_id ? HostForWindow(*params->window_id, browser_context())
+                        : FlechaFrameHost::Main(Profile::FromBrowserContext(
+                                                    browser_context())
+                                                    ->GetOriginalProfile());
+  if (!host) {
+    return RespondNow(Error(kNoWindowError, "(find)"));
+  }
+  chrome::Find(host->GetBrowserWindowInterface());
   return RespondNow(NoArguments());
 }
 
