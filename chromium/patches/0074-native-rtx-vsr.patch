+#include "base/memory/raw_ptr.h"
+#include "base/trace_event/trace_event.h"
+#include "components/viz/service/display_embedder/flecha_vsr_api.h"
+#include "gpu/command_buffer/service/shared_context_state.h"
+#include "gpu/command_buffer/service/vulkan_context_provider.h"
+#include "gpu/config/gpu_finch_features.h"
+#include "gpu/vulkan/vulkan_fence_helper.h"
+#include "gpu/vulkan/vulkan_function_pointers.h"
+#include "gpu/vulkan/vulkan_image.h"
+#include "gpu/vulkan/vulkan_util.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+#include "third_party/skia/include/core/SkSamplingOptions.h"
+#include "third_party/skia/include/core/SkSurface.h"
+#include "third_party/skia/include/gpu/ganesh/GrDirectContext.h"
+#include "third_party/skia/include/gpu/ganesh/SkSurfaceGanesh.h"
+#include "third_party/skia/include/gpu/ganesh/vk/GrVkBackendSemaphore.h"
+#include "third_party/skia/include/gpu/ganesh/vk/GrVkBackendSurface.h"
+#include "third_party/skia/include/gpu/ganesh/vk/GrVkTypes.h"
+#include "third_party/skia/include/gpu/vk/VulkanMutableTextureState.h"
+#include "ui/gfx/geometry/size_conversions.h"
+
+namespace viz {
+namespace {
+// The preloaded bridge remains loaded for the lifetime of the GPU process.
+struct Api {
+  std::atomic<bool> disabled{false};
+  decltype(&flecha_vsr_create) create = nullptr;
+  decltype(&flecha_vsr_destroy) destroy = nullptr;
+  decltype(&flecha_vsr_bind) bind = nullptr;
+  decltype(&flecha_vsr_release) release = nullptr;
+  decltype(&flecha_vsr_process) process = nullptr;
+  decltype(&flecha_vsr_last_error) error = nullptr;
+  Api() {
+    create = reinterpret_cast<decltype(create)>(
+        dlsym(RTLD_DEFAULT, "flecha_vsr_create"));
+    destroy = reinterpret_cast<decltype(destroy)>(
+        dlsym(RTLD_DEFAULT, "flecha_vsr_destroy"));
+    bind = reinterpret_cast<decltype(bind)>(
+        dlsym(RTLD_DEFAULT, "flecha_vsr_bind"));
+    release = reinterpret_cast<decltype(release)>(
+        dlsym(RTLD_DEFAULT, "flecha_vsr_release"));
+    process = reinterpret_cast<decltype(process)>(
+        dlsym(RTLD_DEFAULT, "flecha_vsr_process"));
+    error = reinterpret_cast<decltype(error)>(
+        dlsym(RTLD_DEFAULT, "flecha_vsr_last_error"));
+  }
+  bool available() const {
+    return !disabled.load(std::memory_order_relaxed) && create && destroy &&
+           bind && release && process && error;
+  }
+};
+Api& Bridge() {
+  static Api api;
+  return api;
+}
+
+GrBackendTexture WrapImage(gpu::VulkanImage* image) {
+  GrVkImageInfo info;
+  info.fImage = image->image();
+  info.fAlloc.fMemory = image->device_memory();
+  info.fAlloc.fSize = image->device_size();
+  info.fFormat = image->format();
+  info.fImageUsageFlags = image->usage();
+  info.fLevelCount = 1;
+  info.fCurrentQueueFamily = image->device_queue()->GetVulkanQueueIndex();
+  return GrBackendTextures::MakeVk(image->size().width(),
+                                   image->size().height(), info);
+}
+sk_sp<SkSurface> WrapSurface(GrDirectContext* context,
+                             const GrBackendTexture& texture) {
+  return SkSurfaces::WrapBackendTexture(
+      context, texture, kTopLeft_GrSurfaceOrigin, 1, kBGRA_8888_SkColorType,
+      SkColorSpace::MakeSRGB(), nullptr);
+}
+void DrawSource(SkSurface* surface, SkImage* source) {
+  surface->getCanvas()->drawImageRect(
+      source, SkRect::MakeWH(surface->width(), surface->height()),
+      SkSamplingOptions(SkFilterMode::kLinear), nullptr);
+}
+}  // namespace
+
+std::optional<gfx::Size> GetFlechaVideoOutputSize(
+    const TransferableResource& resource) {
+  if (!base::FeatureList::IsEnabled(features::kFlechaVsr) ||
+      !Bridge().available() ||
+      resource.resource_source !=
+          TransferableResource::ResourceSource::kVideo ||
+      resource.GetColorSpace().IsHDR() || resource.hdr_metadata.HasAgtm() ||
+      (resource.GetFormat().HasAlpha() &&
+       resource.shared_image()->alpha_type() != kOpaque_SkAlphaType) ||
+      resource.shared_image()->usage().Has(
+          gpu::SHARED_IMAGE_USAGE_PROTECTED_VIDEO)) {
+    return std::nullopt;
+  }
+  const auto size = resource.GetSize();
+  // Preserve the existing project's 1.5x default, 1440p output policy, and
+  // 16-pixel alignment. These are not new SDK or hardware restrictions.
+  if (size.IsEmpty() || size.height() >= 1440) {
+    return std::nullopt;
+  }
+  const float scale = std::min(1.5f, 1440.f / size.height());
+  const auto scaled = gfx::ScaleToCeiledSize(size, scale);
+  return gfx::Size(
+      base::bits::AlignUp(static_cast<uint32_t>(scaled.width()), 16u),
+      base::bits::AlignUp(static_cast<uint32_t>(scaled.height()), 16u));
+}
+
+struct FlechaVideoProcessor::Resources {
+  raw_ptr<gpu::SharedContextState> context;
+  raw_ptr<gpu::VulkanDeviceQueue> queue;
+  std::unique_ptr<gpu::VulkanImage> input;
+  std::unique_ptr<gpu::VulkanImage> output;
+  GrBackendTexture input_texture;
+  GrBackendTexture output_texture;
+  sk_sp<SkSurface> input_surface;
+  sk_sp<SkSurface> output_surface;
+  sk_sp<GrPromiseImageTexture> promise;
+  raw_ptr<FlechaVsrProcessor> processor = nullptr;
+  raw_ptr<FlechaVsrFrame> frame = nullptr;
+  VkSemaphore input_ready = VK_NULL_HANDLE;
+  VkSemaphore output_ready = VK_NULL_HANDLE;
+  bool context_lost = false;
+
+  ~Resources() {
+    // A lost GPU may never signal an outstanding external semaphore. Abandon
+    // CUDA handles in that case; process teardown reclaims them without
+    // waiting.
+    if (!context_lost) {
+      if (frame) {
+        Bridge().release(frame);
+      }
+      if (processor) {
+        Bridge().destroy(processor);
+      }
+    }
+    promise.reset();
+    input_surface.reset();
+    output_surface.reset();
+    const auto device = queue->GetVulkanDevice();
+    if (input_ready) {
+      vkDestroySemaphore(device, input_ready, nullptr);
+    }
+    if (output_ready) {
+      vkDestroySemaphore(device, output_ready, nullptr);
+    }
+    if (input) {
+      input->Destroy();
+    }
+    if (output) {
+      output->Destroy();
+    }
+  }
+};
+
+std::unique_ptr<FlechaVideoProcessor> FlechaVideoProcessor::Create(
+    gpu::SharedContextState* context,
+    const gfx::Size& input_size,
+    const gfx::Size& output_size) {
+  if (!Bridge().available() || !context->GrContextIsVulkan()) {
+    return nullptr;
+  }
+  auto resources = std::make_unique<Resources>();
+  resources->context = context;
+  resources->queue = context->vk_context_provider()->GetDeviceQueue();
+  constexpr VkImageUsageFlags usage =
+      VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+      VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+  resources->input = gpu::VulkanImage::CreateWithExternalMemory(
+      resources->queue, input_size, VK_FORMAT_B8G8R8A8_UNORM, usage);
+  resources->output = gpu::VulkanImage::CreateWithExternalMemory(
+      resources->queue, output_size, VK_FORMAT_B8G8R8A8_UNORM, usage);
+  if (!resources->input || !resources->output) {
+    return nullptr;
+  }
+  resources->input_texture = WrapImage(resources->input.get());
+  resources->output_texture = WrapImage(resources->output.get());
+  resources->input_surface =
+      WrapSurface(context->gr_context(), resources->input_texture);
+  resources->output_surface =
+      WrapSurface(context->gr_context(), resources->output_texture);
+  resources->promise = GrPromiseImageTexture::Make(resources->output_texture);
+  if (!resources->input_surface || !resources->output_surface ||
+      !resources->promise) {
+    return nullptr;
+  }
+
+  auto* queue = resources->queue.get();
+  VkPhysicalDeviceIDProperties id{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES};
+  VkPhysicalDeviceProperties2 properties{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+  properties.pNext = &id;
+  vkGetPhysicalDeviceProperties2(queue->GetVulkanPhysicalDevice(), &properties);
+  resources->processor =
+      Bridge().create(id.deviceUUID, input_size.width(), input_size.height(),
+                      output_size.width(), output_size.height(), 2);
+  if (resources->processor &&
+      gpu::IsVkOpaqueExternalSemaphoreSupported(queue)) {
+    resources->input_ready =
+        gpu::CreateVkOpaqueExternalSemaphore(queue->GetVulkanDevice());
+    resources->output_ready =
+        gpu::CreateVkOpaqueExternalSemaphore(queue->GetVulkanDevice());
+    if (resources->input_ready && resources->output_ready) {
+      auto in_fd = resources->input->GetMemoryFd();
+      auto out_fd = resources->output->GetMemoryFd();
+      auto ready_fd = gpu::ExportVkOpaqueExternalSemaphore(
+                          queue->GetVulkanDevice(), resources->input_ready)
+                          .TakeHandle();
+      auto done_fd = gpu::ExportVkOpaqueExternalSemaphore(
+                         queue->GetVulkanDevice(), resources->output_ready)
+                         .TakeHandle();
+      resources->frame =
+          Bridge().bind(resources->processor,
+                        {in_fd.get(), resources->input->device_size(),
+                         static_cast<uint32_t>(input_size.width()),
+                         static_cast<uint32_t>(input_size.height())},
+                        {out_fd.get(), resources->output->device_size(),
+                         static_cast<uint32_t>(output_size.width()),
+                         static_cast<uint32_t>(output_size.height())},
+                        ready_fd.get(), done_fd.get());
+    }
+  }
+  if (!resources->frame) {
+    LOG(ERROR) << "Flecha VSR unavailable, using GPU scaling: "
+               << Bridge().error();
+  }
+  return base::WrapUnique(new FlechaVideoProcessor(std::move(resources)));
+}
+
+FlechaVideoProcessor::FlechaVideoProcessor(std::unique_ptr<Resources> resources)
+    : resources_(std::move(resources)) {}
+
+FlechaVideoProcessor::~FlechaVideoProcessor() {
+  // Keep the imported storage alive until all compositor sampling has finished.
+  resources_->context_lost |= resources_->context->context_lost();
+  if (resources_->context_lost) {
+    Bridge().disabled.store(true, std::memory_order_relaxed);
+  } else {
+    // Also submit any pending CUDA completion wait if a paint was cancelled.
+    resources_->context->gr_context()->flushAndSubmit(GrSyncCpu::kNo);
+  }
+  auto* queue = resources_->queue.get();
+  queue->GetFenceHelper()->EnqueueCleanupTaskForSubmittedWork(base::BindOnce(
+      [](std::unique_ptr<Resources> resources, gpu::VulkanDeviceQueue*,
+         bool lost) {
+        resources->context_lost |= lost;
+        if (resources->context_lost) {
+          Bridge().disabled.store(true, std::memory_order_relaxed);
+        }
+      },
+      std::move(resources_)));
+}
+
+bool FlechaVideoProcessor::Process(
+    sk_sp<SkImage> source,
+    std::vector<GrBackendSemaphore>* source_waits) {
+  auto& r = *resources_;
+  auto* context = r.context->gr_context();
+  if (!source_waits->empty()) {
+    auto* target = r.frame ? r.input_surface.get() : r.output_surface.get();
+    if (!target->wait(source_waits->size(), source_waits->data(), false)) {
+      return false;
+    }
+    source_waits->clear();
+  }
+  if (!r.frame) {
+    DrawSource(r.output_surface.get(), source.get());
+    return true;
+  }
+  TRACE_EVENT("viz", "FlechaVsr::Process");
+  DrawSource(r.input_surface.get(), source.get());
+  // Release both images to CUDA. The input semaphore includes these ownership
+  // and layout barriers as well as the GPU YUV-to-RGB conversion above.
+  const auto external = skgpu::MutableTextureStates::MakeVulkan(
+      VK_IMAGE_LAYOUT_GENERAL, VK_QUEUE_FAMILY_EXTERNAL);
+  if (!context->setBackendTextureState(r.output_texture, external)) {
+    return false;
+  }
+  GrBackendSemaphore ready = GrBackendSemaphores::MakeVk(r.input_ready);
+  GrFlushInfo flush{.fNumSemaphores = 1, .fSignalSemaphores = &ready};
+  auto result = context->flush(r.input_surface.get(), flush, &external);
+  if (!result.fSuccess || result.fSubmitted != GrSemaphoresSubmitted::kYes ||
+      !context->submit(GrSyncCpu::kNo)) {
+    return false;
+  }
+  const int processed = Bridge().process(r.frame);
+  if (processed < 0) {
+    LOG(ERROR) << "Flecha VSR CUDA context failed: " << Bridge().error();
+    r.context_lost = true;
+    Bridge().disabled.store(true, std::memory_order_relaxed);
+    r.context->MarkContextLost();
+    return false;
+  }
+  GrBackendSemaphore done = GrBackendSemaphores::MakeVk(r.output_ready);
+  // The normal compositor flush acquires ownership and samples this texture
+  // after the CUDA signal. There is no per-frame CPU synchronization.
+  if (!context->wait(1, &done, false)) {
+    // CUDA may still be writing. Abandon the imports instead of retiring them
+    // behind a Vulkan fence that does not cover the failed completion wait.
+    r.context_lost = true;
+    Bridge().disabled.store(true, std::memory_order_relaxed);
+    r.context->MarkContextLost();
+    return false;
+  }
+  if (!processed) {
+    LOG(ERROR) << "Flecha VSR inference failed, using GPU scaling: "
+               << Bridge().error();
+    DrawSource(r.output_surface.get(), source.get());
+  } else {
+    // Record activation, rather than merely reporting that the SDK loaded.
+    static bool activated = false;
+    if (!activated) {
+      activated = true;
+      LOG(INFO) << "Flecha VSR: native GPU video processing active, "
+                << r.input->size().ToString() << " -> "
+                << r.output->size().ToString();
+    }
+  }
+  return true;
+}
+
+GrPromiseImageTexture* FlechaVideoProcessor::texture() const {
+  return resources_->promise.get();
+}
+void FlechaVideoProcessor::OnContextLost() {
+  resources_->context_lost = true;
+  Bridge().disabled.store(true, std::memory_order_relaxed);
+}
+}  // namespace viz
