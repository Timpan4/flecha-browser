+// Flecha: native VSR boundary. Pixel storage stays in Vulkan device memory.
+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_FLECHA_VSR_API_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_FLECHA_VSR_API_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct FlechaVsrProcessor FlechaVsrProcessor;
+typedef struct FlechaVsrFrame FlechaVsrFrame;
+
+// Prepare before the GPU sandbox starts. The browser client connects to its
+// local worker, which owns the NVIDIA driver and model.
+int flecha_vsr_prepare(void);
+
+// A dedicated VK_FORMAT_B8G8R8A8_UNORM image allocated with OPAQUE_FD export.
+// Descriptors are borrowed. The bridge duplicates them before CUDA import.
+typedef struct FlechaVsrImage {
+  int memory_fd;
+  uint64_t allocation_bytes;
+  uint32_t width;
+  uint32_t height;
+} FlechaVsrImage;
+
+// Call on a single GPU sequence. The UUID must match the Vulkan physical
+// device.
+FlechaVsrProcessor* flecha_vsr_create(const unsigned char device_uuid[16],
+                                      uint32_t input_width,
+                                      uint32_t input_height,
+                                      uint32_t output_width,
+                                      uint32_t output_height,
+                                      uint32_t quality);
+void flecha_vsr_destroy(FlechaVsrProcessor* processor);
+
+// Semaphores must be exportable binary Vulkan semaphores (OPAQUE_FD).
+FlechaVsrFrame* flecha_vsr_bind(FlechaVsrProcessor* processor,
+                                FlechaVsrImage input,
+                                FlechaVsrImage output,
+                                int input_ready_fd,
+                                int output_ready_fd);
+// Release before processing, or after a Vulkan/compositor completion fence.
+// Standalone clients can instead call flecha_vsr_synchronize first.
+void flecha_vsr_release(FlechaVsrFrame* frame);
+
+// Enqueue CUDA wait -> device copy -> VSR -> device copy -> CUDA signal.
+// Returns without a CPU wait. Vulkan must wait on output_ready before sampling.
+// 1: success, 0: failed with completion signal queued, -1: CUDA context
+// failure.
+int flecha_vsr_process(FlechaVsrFrame* frame);
+// Initialization/teardown and standalone verification only, never per-frame.
+int flecha_vsr_synchronize(FlechaVsrProcessor* processor);
+const char* flecha_vsr_last_error(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
