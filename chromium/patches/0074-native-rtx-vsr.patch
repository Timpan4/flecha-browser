@@ -0,0 +1,42 @@
+// Flecha: GPU-only video enhancement between shared-image access and sampling.
+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_FLECHA_VIDEO_PROCESSOR_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_FLECHA_VIDEO_PROCESSOR_H_
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "components/viz/common/resources/transferable_resource.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/gpu/ganesh/GrBackendSemaphore.h"
+#include "third_party/skia/include/private/chromium/GrPromiseImageTexture.h"
+
+namespace gpu {
+class SharedContextState;
+}
+
+namespace viz {
+
+std::optional<gfx::Size> GetFlechaVideoOutputSize(
+    const TransferableResource& resource);
+
+class FlechaVideoProcessor {
+ public:
+  static std::unique_ptr<FlechaVideoProcessor> Create(
+      gpu::SharedContextState* context,
+      const gfx::Size& input_size,
+      const gfx::Size& output_size);
+  ~FlechaVideoProcessor();
+
+  bool Process(sk_sp<SkImage> source,
+               std::vector<GrBackendSemaphore>* source_waits);
+  GrPromiseImageTexture* texture() const;
+  void OnContextLost();
+
+ private:
+  struct Resources;
+  explicit FlechaVideoProcessor(std::unique_ptr<Resources> resources);
+  std::unique_ptr<Resources> resources_;
+};
+}  // namespace viz
+#endif
