+namespace {
+
+// Flecha: the shell's vote to freeze a tab (setTabFreezing()). It lives as
+// long as the tab or until the shell takes it back.
+class FlechaFreezingVote
+    : public content::WebContentsUserData<FlechaFreezingVote> {
+ public:
+  ~FlechaFreezingVote() override = default;
+
+ private:
+  friend class content::WebContentsUserData<FlechaFreezingVote>;
+  explicit FlechaFreezingVote(content::WebContents* contents)
+      : content::WebContentsUserData<FlechaFreezingVote>(*contents),
+        vote_(contents) {}
+
+  performance_manager::freezing::FreezingVote vote_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(FlechaFreezingVote);
+
+}  // namespace
+
+ExtensionFunction::ResponseAction FlechaPrivateSetTabFreezingFunction::Run() {
+  auto params = flecha_private::SetTabFreezing::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  if (params->can_freeze) {
+    FlechaFreezingVote::CreateForWebContents(contents);
+  } else {
+    contents->RemoveUserData(FlechaFreezingVote::UserDataKey());
+  }
+  return RespondNow(NoArguments());
+}
+
 }  // namespace extensions
