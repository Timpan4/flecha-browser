+ExtensionFunction::ResponseAction
+FlechaPrivateShowExtensionsMenuFunction::Run() {
+  auto params = flecha_private::ShowExtensionsMenu::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  FlechaFrameHost* host = HostForWindow(params->window_id, browser_context());
+  if (!host) {
+    return RespondNow(
+        Error(kNoWindowError, base::NumberToString(params->window_id)));
+  }
+  if (!host->ShowExtensionsMenu(ToRect(params->anchor))) {
+    return RespondNow(Error("This window has no extensions menu."));
+  }
+  return RespondNow(NoArguments());
+}
