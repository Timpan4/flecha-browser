+void FlechaFrameView::OnExtensionPopupTriggered(const std::string& action_id) {
+  auto* background =
+      views::AsViewClass<FlechaFrameBackgroundView>(background_view());
+  // An action picked in the extensions menu drops from the sidebar's
+  // extensions button, as Chromium's pops out next to its toolbar button.
+  if (background && action_id != action_anchor_id_ &&
+      GetSidebarExtensionsMenu()) {
+    SetActionAnchor(action_id, background->menu_anchor()->bounds());
+  }
+}
+
+views::View* FlechaFrameView::GetExtensionsMenuAnchorView() {
+  auto* background =
+      views::AsViewClass<FlechaFrameBackgroundView>(background_view());
+  return background && opening_extensions_menu_ && IsActive()
+             ? background->menu_anchor()
+             : nullptr;
+}
+
+views::Widget* FlechaFrameView::GetSidebarExtensionsMenu() {
+  auto* background =
+      views::AsViewClass<FlechaFrameBackgroundView>(background_view());
+  if (!background || !GetWidget()) {
+    return nullptr;
+  }
+  for (views::Widget* widget :
+       views::Widget::GetAllOwnedWidgets(GetWidget()->GetNativeView())) {
+    views::BubbleDialogDelegate* bubble =
+        widget->widget_delegate()
+            ? widget->widget_delegate()->AsBubbleDialogDelegate()
+            : nullptr;
+    // One that is closing counts: a press that takes focus from the menu
+    // starts closing it before the window sees the press.
+    if (bubble && bubble->GetAnchorView() == background->menu_anchor()) {
+      return widget;
+    }
+  }
+  return nullptr;
+}
+
+bool FlechaFrameView::ShowExtensionsMenu(const gfx::Rect& anchor) {
+  ExtensionsContainer* container =
+      ExtensionsContainer::From(*browser_view_->browser());
+  auto* background =
+      views::AsViewClass<FlechaFrameBackgroundView>(background_view());
+  if (!container || !background) {
+    return false;
+  }
+  // A second click on the button closes the menu, as on the toolbar. The
+  // press usually closed it already (it took focus from the menu).
+  const std::optional<gfx::Point> press =
+      std::exchange(extensions_menu_press_, std::nullopt);
+  if ((press && anchor.Contains(*press)) || GetSidebarExtensionsMenu()) {
+    container->CloseExtensionsMenuIfOpen();
+    return true;
+  }
+  background->menu_anchor()->SetBoundsRect(anchor);
+  background->menu_anchor()->SetVisible(!anchor.IsEmpty());
+  base::AutoReset<bool> opening(&opening_extensions_menu_, true);
+  container->ToggleExtensionsMenu();
+  return true;
+}
