@@ -0,0 +1,31 @@
+// Flecha: one process-wide configuration shared by Viz and GPU sequences.
+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_FLECHA_VIDEO_SETTINGS_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_FLECHA_VIDEO_SETTINGS_H_
+
+#include <cstdint>
+#include <string>
+
+namespace viz {
+struct FlechaVideoSettings {
+  bool enabled = true;
+  uint32_t quality = 2;
+  uint32_t max_output_height = 1440;
+};
+struct FlechaVideoStatus {
+  FlechaVideoSettings settings;
+  uint64_t processed_frames = 0;
+  uint32_t input_width = 0;
+  uint32_t input_height = 0;
+  uint32_t output_width = 0;
+  uint32_t output_height = 0;
+  std::string error;
+};
+FlechaVideoStatus GetFlechaVideoStatus();
+bool SetFlechaVideoSettings(FlechaVideoSettings settings);
+void RecordFlechaVideoFrame(uint32_t input_width,
+                            uint32_t input_height,
+                            uint32_t output_width,
+                            uint32_t output_height);
+void RecordFlechaVideoError(std::string error);
+}  // namespace viz
+#endif
diff --git a/components/viz/service/display_embedder/flecha_video_settings.cc b/components/viz/service/display_embedder/flecha_video_settings.cc
new file mode 100644
index 0000000..8e34fcd
--- /dev/null
+++ b/components/viz/service/display_embedder/flecha_video_settings.cc
@@ -0,0 +1,83 @@
+// Flecha: settings survive GPU restarts through browser-supplied switches.
+#include "components/viz/service/display_embedder/flecha_video_settings.h"
+
+#include <limits>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/synchronization/lock.h"
+
+namespace viz {
+namespace {
+bool ValidSettings(const FlechaVideoSettings& settings) {
+  // NVIDIA VFX's LOW, MEDIUM, HIGH and ULTRA upscaling modes are 1 through 4.
+  // gfx::Size dimensions must fit a positive signed int.
+  return settings.quality >= 1 && settings.quality <= 4 &&
+         settings.max_output_height > 0 &&
+         settings.max_output_height <= std::numeric_limits<int>::max();
+}
+struct Runtime {
+  Runtime() {
+    const auto* command = base::CommandLine::ForCurrentProcess();
+    auto settings = status.settings;
+    settings.enabled = !command->HasSwitch("flecha-vsr-disabled");
+    uint32_t value;
+    if (base::StringToUint(command->GetSwitchValueASCII("flecha-vsr-quality"),
+                           &value)) {
+      settings.quality = value;
+    }
+    if (base::StringToUint(
+            command->GetSwitchValueASCII("flecha-vsr-max-height"), &value)) {
+      settings.max_output_height = value;
+    }
+    if (ValidSettings(settings)) {
+      status.settings = settings;
+    }
+  }
+  base::Lock lock;
+  FlechaVideoStatus status;
+};
+Runtime& State() {
+  static base::NoDestructor<Runtime> runtime;
+  return *runtime;
+}
+}  // namespace
+
+FlechaVideoStatus GetFlechaVideoStatus() {
+  auto& state = State();
+  base::AutoLock lock(state.lock);
+  return state.status;
+}
+
+bool SetFlechaVideoSettings(FlechaVideoSettings settings) {
+  if (!ValidSettings(settings)) {
+    return false;
+  }
+  auto& state = State();
+  base::AutoLock lock(state.lock);
+  state.status.settings = settings;
+  return true;
+}
+
+void RecordFlechaVideoFrame(uint32_t input_width,
+                            uint32_t input_height,
+                            uint32_t output_width,
+                            uint32_t output_height) {
+  auto& state = State();
+  base::AutoLock lock(state.lock);
+  ++state.status.processed_frames;
+  state.status.input_width = input_width;
+  state.status.input_height = input_height;
+  state.status.output_width = output_width;
+  state.status.output_height = output_height;
+  state.status.error.clear();
+}
+
+void RecordFlechaVideoError(std::string error) {
+  auto& state = State();
+  base::AutoLock lock(state.lock);
+  state.status.error = std::move(error);
+}
+}  // namespace viz
