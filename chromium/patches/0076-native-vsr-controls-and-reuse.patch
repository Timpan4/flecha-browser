+// Flecha: browser-wide video prefs, also supplied to every new GPU process.
+#ifndef CHROME_BROWSER_FLECHA_FLECHA_VIDEO_PREFERENCES_H_
+#define CHROME_BROWSER_FLECHA_FLECHA_VIDEO_PREFERENCES_H_
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/gpu_utils.h"
+
+namespace flecha {
+inline constexpr char kVsrEnabled[] = "flecha.vsr.enabled";
+inline constexpr char kVsrQuality[] = "flecha.vsr.quality";
+inline constexpr char kVsrMaxHeight[] = "flecha.vsr.max_output_height";
+
+inline void RegisterVideoPreferences(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kVsrEnabled, true);
+  registry->RegisterIntegerPref(kVsrQuality, 2);
+  registry->RegisterIntegerPref(kVsrMaxHeight, 1440);
+}
+inline content::FlechaVsrSettings ReadVideoPreferences() {
+  auto* prefs = g_browser_process->local_state();
+  const int quality = prefs->GetInteger(kVsrQuality);
+  const int height = prefs->GetInteger(kVsrMaxHeight);
+  return {prefs->GetBoolean(kVsrEnabled),
+          static_cast<uint32_t>(quality >= 1 && quality <= 4 ? quality : 2),
+          static_cast<uint32_t>(height > 0 ? height : 1440)};
+}
+inline void AppendVideoPreferences(base::CommandLine* command) {
+  const auto settings = ReadVideoPreferences();
+  if (!settings.enabled) {
+    command->AppendSwitch("flecha-vsr-disabled");
+  }
+  command->AppendSwitchASCII("flecha-vsr-quality",
+                             base::NumberToString(settings.quality));
+  command->AppendSwitchASCII("flecha-vsr-max-height",
+                             base::NumberToString(settings.max_output_height));
+}
+}  // namespace flecha
+#endif
