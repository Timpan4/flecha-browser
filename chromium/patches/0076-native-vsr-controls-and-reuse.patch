+
+void FlechaVideoProcessorPool::Recycle(
+    std::unique_ptr<FlechaVideoProcessor::Resources> resources) {
+  idle_bytes_ += resources->allocation_bytes();
+  idle_.push_back(std::move(resources));
+  TrimIdleResources();
+}
+
+void FlechaVideoProcessorPool::TrimIdleResources() {
+  if (context_->context_lost()) {
+    for (auto& resources : idle_) {
+      resources->context_lost = true;
+    }
+    idle_.clear();
+    idle_bytes_ = 0;
+    return;
+  }
+  // Reuse Chromium's configured Skia cache budget, including its pressure
+  // adjustments. Never evict leased slots or invent another VRAM threshold.
+  const size_t budget = context_->gr_context()->getResourceCacheLimit();
+  while (idle_bytes_ > budget && !idle_.empty()) {
+    idle_bytes_ -= idle_.front()->allocation_bytes();
+    idle_.erase(idle_.begin());
+  }
 }
 
