+std::unique_ptr<FlechaVideoProcessor> FlechaVideoProcessorPool::Acquire(
+    const gfx::Size& input_size,
+    const gfx::Size& output_size,
+    uint32_t quality) {
+  TrimIdleResources();
+  for (auto it = idle_.begin(); it != idle_.end(); ++it) {
+    if ((*it)->input->size() == input_size &&
+        (*it)->output->size() == output_size && (*it)->quality == quality) {
+      auto resources = std::move(*it);
+      idle_.erase(it);
+      idle_bytes_ -= resources->allocation_bytes();
+      return base::WrapUnique(new FlechaVideoProcessor(
+          std::move(resources), weak_factory_.GetWeakPtr()));
+    }
+  }
+  return FlechaVideoProcessor::Create(context_, input_size, output_size,
+                                      quality, weak_factory_.GetWeakPtr());
