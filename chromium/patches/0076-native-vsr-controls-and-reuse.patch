+#include "base/check_op.h"
+#include "base/command_line.h"
+
+int main(int argc, char** argv) {
+  base::CommandLine::Init(argc, argv);
+  using namespace viz;
+  CHECK_EQ(GetFlechaVideoStatus().processed_frames, 0u);
+  CHECK(SetFlechaVideoSettings({false, 4, 2160}));
+  CHECK(!GetFlechaVideoStatus().settings.enabled);
+  CHECK_EQ(GetFlechaVideoStatus().settings.quality, 4u);
+  CHECK_EQ(GetFlechaVideoStatus().settings.max_output_height, 2160u);
+  // Invalid boundary input must leave the previous settings intact.
+  CHECK(!SetFlechaVideoSettings({true, 0, 1440}));
+  CHECK(!SetFlechaVideoSettings({true, 5, 1440}));
+  CHECK(!SetFlechaVideoSettings({true, 2, 0}));
+  CHECK(!SetFlechaVideoSettings(
+      {true, 2, static_cast<uint32_t>(std::numeric_limits<int>::max()) + 1u}));
+  CHECK(!GetFlechaVideoStatus().settings.enabled);
+  CHECK_EQ(GetFlechaVideoStatus().settings.quality, 4u);
+  CHECK(SetFlechaVideoSettings({true, 2, 1440}));
+  RecordFlechaVideoError("inference unavailable");
+  CHECK_EQ(GetFlechaVideoStatus().processed_frames, 0u);
+  CHECK_EQ(GetFlechaVideoStatus().error, "inference unavailable");
+  RecordFlechaVideoFrame(1280, 720, 1920, 1088);
+  const auto status = GetFlechaVideoStatus();
+  CHECK_EQ(status.processed_frames, 1u);
+  CHECK_EQ(status.input_width, 1280u);
+  CHECK_EQ(status.output_height, 1088u);
+  CHECK(status.error.empty());
+  std::puts(
+      "PASS: live VSR settings, boundary validation and processed-frame "
+      "status");
+}
