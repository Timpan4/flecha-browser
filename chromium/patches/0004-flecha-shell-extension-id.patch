+#ifndef CHROME_BROWSER_FLECHA_FLECHA_SHELL_H_
+#define CHROME_BROWSER_FLECHA_FLECHA_SHELL_H_
+
+#include <string_view>
+
+// Flecha's shell extension (chromium/shell in the Flecha repo): the window
+// frame, the new tab page and Settings. Its ID is fixed by the "key" in
+// chromium/shell/manifest.json, so it stays the same wherever the unpacked
+// extension is loaded from. Change both together.
+inline constexpr char kFlechaShellExtensionId[] =
+    "abdiaepfgbbhdjaecjipmaailijaaide";
+
+inline bool IsFlechaShell(std::string_view extension_id) {
+  return extension_id == kFlechaShellExtensionId;
+}
+
+#endif  // CHROME_BROWSER_FLECHA_FLECHA_SHELL_H_
