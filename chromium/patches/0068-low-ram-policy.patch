+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/performance_manager/policies/flecha_low_ram_policy.h"
+
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/system/sys_info.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/performance_manager/policies/discard_eligibility_policy.h"
+#include "chrome/browser/performance_manager/policies/page_discarding_helper.h"
+#include "components/performance_manager/public/graph/page_node.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/web_contents.h"
+
+namespace performance_manager::policies {
+
+BASE_FEATURE(kFlechaLowRamPolicy, base::FEATURE_ENABLED_BY_DEFAULT);
+
+// Dia's defaults: low-ram-policy-threshold-mb, -extra-ram-to-free-over-
+// threshold-mb, -short-cooldown-seconds and -long-cooldown-seconds.
+const base::FeatureParam<int> kFlechaLowRamThresholdMb = {&kFlechaLowRamPolicy,
+                                                          "threshold_mb", 200};
+const base::FeatureParam<int> kFlechaLowRamExtraMb = {&kFlechaLowRamPolicy,
+                                                      "extra_mb", 100};
+const base::FeatureParam<base::TimeDelta> kFlechaLowRamShortCooldown = {
+    &kFlechaLowRamPolicy, "short_cooldown", base::Seconds(60)};
+const base::FeatureParam<base::TimeDelta> kFlechaLowRamLongCooldown = {
+    &kFlechaLowRamPolicy, "long_cooldown", base::Seconds(600)};
+
+namespace {
+
+// What PageDiscardingHelper assumes for a page whose footprint hasn't been
+// measured yet (page_discarding_helper.cc, DiscardMultiplePagesImpl).
+constexpr base::ByteSize kUnmeasuredPageFootprint = base::MiB(80);
+
+// A feature param's megabytes; a negative one counts as none.
+base::ByteSize Megabytes(int megabytes) {
+  return base::MiB(static_cast<uint64_t>(std::max(megabytes, 0)));
+}
+
+}  // namespace
+
+FlechaLowRamPolicy::FlechaLowRamPolicy() = default;
+FlechaLowRamPolicy::~FlechaLowRamPolicy() = default;
+
+void FlechaLowRamPolicy::OnPassedToGraph(Graph* graph) {
+  graph_ = graph;
+  registration_.emplace(base::MemoryPressureListenerTag::kFlechaLowRamPolicy,
+                        this);
+}
+
+void FlechaLowRamPolicy::OnTakenFromGraph(Graph* graph) {
+  registration_.reset();
+  weak_factory_.InvalidateWeakPtrs();
+  graph_ = nullptr;
+}
+
+void FlechaLowRamPolicy::OnMemoryPressure(base::MemoryPressureLevel level) {
+  // Dia acts on moderate pressure only, outside its cooldown.
+  if (level != base::MEMORY_PRESSURE_LEVEL_MODERATE || reading_ ||
+      base::TimeTicks::Now() < next_allowed_) {
+    return;
+  }
+  reading_ = true;
+  // Reading free memory can block (on Linux it reads /proc/meminfo).
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [] { return base::SysInfo::AmountOfAvailablePhysicalMemory(); }),
+      base::BindOnce(&FlechaLowRamPolicy::OnAvailableMemory,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void FlechaLowRamPolicy::OnAvailableMemory(base::ByteSize available) {
+  reading_ = false;
+  const base::ByteSize threshold = Megabytes(kFlechaLowRamThresholdMb.Get());
+  if (available >= threshold) {
+    return;
+  }
+  const bool discarded = DiscardToFree(threshold - available +
+                                       Megabytes(kFlechaLowRamExtraMb.Get()));
+  next_allowed_ =
+      base::TimeTicks::Now() + (discarded ? kFlechaLowRamShortCooldown.Get()
+                                          : kFlechaLowRamLongCooldown.Get());
+}
+
+bool FlechaLowRamPolicy::DiscardToFree(base::ByteSize target) {
+  if (!graph_) {
+    return false;
+  }
+  auto* eligibility = DiscardEligibilityPolicy::GetFromGraph(graph_);
+  auto* helper = graph_->GetRegisteredObjectAs<PageDiscardingHelper>();
+  if (!eligibility || !helper) {
+    return false;
+  }
+  // Dia discards what Chromium's own proactive discards may (its call is
+  // DiscardMultiplePages(target, /*discard_protected_tabs=*/false,
+  // PROACTIVE)). The ten most recently used tabs that Dia's tab policy keeps
+  // from its time rule are kept by Flecha's shell alone, so they aren't
+  // spared here either, as in Dia; a tab an extension made not
+  // auto-discardable is.
+  std::vector<const PageNode*> candidates;
+  for (const PageNode* page : graph_->GetAllPageNodes()) {
+    // Incognito is left alone, as by the shell's tab sleep.
+    const base::WeakPtr<content::WebContents> contents = page->GetWebContents();
+    if (!contents || contents->GetBrowserContext()->IsOffTheRecord()) {
+      continue;
+    }
+    if (eligibility->CanDiscard(
+            page, DiscardEligibilityPolicy::DiscardReason::PROACTIVE,
+            /*ignore_recent_visibility=*/false) ==
+        CanDiscardResult::kEligible) {
+      candidates.push_back(page);
+    }
+  }
+  // The longest in the background first.
+  std::ranges::sort(candidates, {}, &PageNode::GetLastVisibilityChangeTime);
+  std::vector<const PageNode*> chosen;
+  base::ByteSize freed;
+  for (const PageNode* page : candidates) {
+    if (freed >= target) {
+      break;
+    }
+    const base::ByteSize footprint = page->EstimatePrivateFootprintSize();
+    freed += footprint.is_zero() ? kUnmeasuredPageFootprint : footprint;
+    chosen.push_back(page);
+  }
+  return !chosen.empty() &&
+         helper->ImmediatelyDiscardMultiplePages(
+             chosen, DiscardEligibilityPolicy::DiscardReason::PROACTIVE,
+             /*ignore_recent_visibility=*/false,
+             /*eligibility_policy=*/nullptr);
+}
+
+}  // namespace performance_manager::policies
