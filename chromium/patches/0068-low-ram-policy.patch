+#ifndef CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_FLECHA_LOW_RAM_POLICY_H_
+#define CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_FLECHA_LOW_RAM_POLICY_H_
+
+#include <optional>
+
+#include "base/byte_size.h"
+#include "base/feature_list.h"
+#include "base/memory/memory_pressure_listener.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/metrics/field_trial_params.h"
+#include "base/time/time.h"
+#include "components/performance_manager/public/graph/graph.h"
+
+namespace performance_manager::policies {
+
+// Dia's low-RAM policy, as decompiled from Dia 1.54.2's ArcCore
+// (arc/browser/performance/low_ram_policy.cc; the Flecha research notes
+// flecha-perf/findings.md, "Low-RAM policy"): on moderate memory pressure,
+// when free system memory is under a threshold, discard background tabs to
+// free the shortfall plus some more, then wait a short cooldown, or a long one
+// when nothing could be discarded. Its values are Dia's defaults for its
+// low-ram-policy-* flags.
+BASE_DECLARE_FEATURE(kFlechaLowRamPolicy);
+extern const base::FeatureParam<int> kFlechaLowRamThresholdMb;
+extern const base::FeatureParam<int> kFlechaLowRamExtraMb;
+extern const base::FeatureParam<base::TimeDelta> kFlechaLowRamShortCooldown;
+extern const base::FeatureParam<base::TimeDelta> kFlechaLowRamLongCooldown;
+
+class FlechaLowRamPolicy : public GraphOwnedDefaultImpl,
+                           public base::MemoryPressureListener {
+ public:
+  FlechaLowRamPolicy();
+  FlechaLowRamPolicy(const FlechaLowRamPolicy&) = delete;
+  FlechaLowRamPolicy& operator=(const FlechaLowRamPolicy&) = delete;
+  ~FlechaLowRamPolicy() override;
+
+  // GraphOwned:
+  void OnPassedToGraph(Graph* graph) override;
+  void OnTakenFromGraph(Graph* graph) override;
+
+ private:
+  // base::MemoryPressureListener:
+  void OnMemoryPressure(base::MemoryPressureLevel level) override;
+
+  // With the free memory read off the main thread: discards if it is short.
+  void OnAvailableMemory(base::ByteSize available);
+
+  // Discards background pages, oldest shown first, until their estimated
+  // memory reaches `target`. Returns whether any page was discarded.
+  bool DiscardToFree(base::ByteSize target);
+
+  raw_ptr<Graph> graph_ = nullptr;
+  std::optional<base::MemoryPressureListenerRegistration> registration_;
+  // No pressure response before this time (the cooldowns).
+  base::TimeTicks next_allowed_;
+  // A free memory reading is on its way.
+  bool reading_ = false;
+
+  base::WeakPtrFactory<FlechaLowRamPolicy> weak_factory_{this};
+};
+
+}  // namespace performance_manager::policies
+
+#endif  // CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_FLECHA_LOW_RAM_POLICY_H_
