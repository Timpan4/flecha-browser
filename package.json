{
  "name": "flecha",
  "productName": "Flecha",
  "version": "0.1.0",
  "private": true,
  "description": "An Arc-style browser built on Chromium (via Electron).",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:preload && tsc -p src/renderer/tsconfig.json && cp src/renderer/index.html src/renderer/styles.css src/renderer/find.html src/renderer/find.css dist/renderer/",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.js --log-level=warning",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/renderer/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0"
  }
}
